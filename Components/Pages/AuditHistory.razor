@using LMS.Components.Shared
@using LMS.DTOs.AuditHistory
@using LMS.DTOs.TableView
@using LMS.Interfaces
@using LMS.Models.Database
@using LMS.Services
@using Microsoft.AspNetCore.Authorization

@inject UserRequestContext UserRequestContext
@inject NavigationManager NavigationManager
@inject IAuditHistoryService AuditHistoryService

<PageTitle>История изменений БД</PageTitle>
@page "/auditHistory"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Administrator")]

<AccessControl IsLoaded="_isLoaded" CanRead="_canRead" PageName="История изменений">
    <div class="container-fluid px-4 mt-3 animate-fade-in">
        @* Таблица *@
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 border-0">
                <div class="row align-items-center">
                    <div class="col">
                        <h5 class="mb-0 fw-bold text-secondary">Список изменений в базе</h5>
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <TableView TItem="AuditHistoryListItemVm"
                                  StorageKey="AuditHistories"
                                  Data="_page"
                                  Columns="_columns"
                                  Query="_query"
                                  OnQueryChanged="LoadData"/>
                </div>
            </div>
        </div>
    </div>
</AccessControl>



@code {
    private TableQuery _query = new();
    private PagedResult<AuditHistoryListItemVm> _page = new();
    private List<TableColumn<AuditHistoryListItemVm>> _columns = [];
    
    // Флаги состояния и прав
    private bool _isLoaded;
    private bool _canRead;
    
    protected override async Task OnInitializedAsync()
    {
        var userId = UserRequestContext.UserUuid;
        if (userId.HasValue)
        {
            _canRead = await UserRequestContext.HasPermission(DbSchemaConstants.AuditHistory, SqlOperation.Select);

            if (_canRead)
            {
                DefineTableColumns();
                await LoadData(_query);
            }
        }
        
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("search", out var searchValue))
        {
            _query.Search = searchValue;
            await LoadData(_query);
        }
        
        _isLoaded = true;
    }

    private void DefineTableColumns()
    {
        _columns =
        [
            new TableColumn<AuditHistoryListItemVm> { Title = "UUID", Value = a => a.Uuid.ToString(), Sortable = false, SortKey = "uuid" },
            new TableColumn<AuditHistoryListItemVm> { Title = "Имя таблицы", Value = a => a.TableName, Sortable = true, SortKey = "table_name" },
            
            // TODO: Сделать поддержку перехода по идентификатору записи.
            //new TableColumn<AuditHistoryListItemVm> { Title = "UUID записи", Value = a => a.RecordUuid.ToString(), Sortable = true, SortKey = "record_uuid" },
            new TableColumn<AuditHistoryListItemVm> 
            { 
                Title = "Запись", 
                Value = a => a.RecordUuid.ToString(),
                Sortable = false, 
                SortKey = "record_uuid",
                Template = (item) => (builder) => 
                {
                    var url = $"/{item.TableName}?search={item.RecordUuid}";
                    builder.OpenElement(0, "a");
                    builder.AddAttribute(1, "href", url);
                    builder.AddAttribute(2, "class", "badge bg-primary text-decoration-none me-1");
                    builder.AddContent(3, item.RecordUuid.ToString());
                    builder.CloseElement();
                }
            },
            new TableColumn<AuditHistoryListItemVm> { Title = "Действие", Value = a => a.Action.ToString(), Sortable = true, SortKey = "action" },
            new TableColumn<AuditHistoryListItemVm> { Title = "Старые данные", Value = a => a.OldData != null ? a.OldData.RootElement.ToString() : string.Empty, Sortable = false, SortKey = "old_data" },
            new TableColumn<AuditHistoryListItemVm> { Title = "Новые данные", Value = a => a.NewData != null ? a.NewData.RootElement.ToString() : string.Empty, Sortable = false, SortKey = "new_data" },
            new TableColumn<AuditHistoryListItemVm> { Title = "Изменено", Value = a => a.ChangedAt, Sortable = true, SortKey = "changed_at" },
            new TableColumn<AuditHistoryListItemVm> 
            { 
                Title = "Кем изменено", 
                Value = a => a.ChangedBy.ToString(),
                Sortable = true, 
                SortKey = "changed_by",
                Template = (item) => (builder) => 
                {
                    var url = $"/administrators?search={item.ChangedBy}";
                    builder.OpenElement(0, "a");
                    builder.AddAttribute(1, "href", url);
                    builder.AddAttribute(2, "class", "badge bg-primary text-decoration-none me-1");
                    builder.AddContent(3, item.ChangedBy.ToString());
                    builder.CloseElement();
                }
            }];
    }

    private async Task LoadData(TableQuery q)
    {
        if (!_canRead) return;
        _query = q;
        _page = await AuditHistoryService.GetPagedAsync(_query);
    }
}