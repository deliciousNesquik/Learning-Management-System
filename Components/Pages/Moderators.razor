@page "/moderators"
<PageTitle>Модераторы</PageTitle>
@using LMS.Components.Shared
@using LMS.DTOs.Branch
@using LMS.DTOs.General
@using LMS.DTOs.Moderator
@using LMS.DTOs.TableView
@using LMS.Infrastructure.Security
@using LMS.Interfaces
@using LMS.Models.Database
@using LMS.Services
@using Microsoft.AspNetCore.Authorization
@inject IModeratorService ModeratorService
@inject UserPermissions UserPermissions
@inject UserSessionAccessor UserSessionAccessor
@inject IBranchService BranchService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

@attribute [Authorize(Roles = "Admin")]


<AccessControl IsLoaded="isLoaded" CanRead="canRead" PageName="Модераторы">
    <div class="container-fluid px-4 mt-3 animate-fade-in">
        
        @* Статистика *@
        <div class="row mb-4 g-3"> @* g-3 добавляет стандартные отступы между колонками *@
            <div class="col-md-3">
                <div class="card border-0 border-start border-primary border-4 shadow-sm bg-white h-100">
                    <div class="card-body">
                        <h6 class="text-muted small fw-bold text-uppercase">Всего модераторов</h6>
                        <h3 class="mb-0">@stats.Total</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 border-start border-success border-4 shadow-sm bg-white h-100">
                    <div class="card-body">
                        <h6 class="text-muted small fw-bold text-uppercase text-success">Активных</h6>
                        <h3 class="mb-0 text-success">@stats.Active</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 border-start border-warning border-4 shadow-sm bg-white h-100">
                    <div class="card-body">
                        <h6 class="text-muted small fw-bold text-uppercase text-warning">Заблокированных</h6>
                        <h3 class="mb-0 text-warning">@stats.Blocked</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3"> @* Изменил с col-md-2 на col-md-3 *@
                <div class="card border-0 border-start border-danger border-4 shadow-sm bg-white h-100">
                    <div class="card-body">
                        <h6 class="text-muted small fw-bold text-uppercase text-danger">Орг. без модераторов</h6>
                        <h3 class="mb-0 text-danger">@stats.OrganizationsWithoutModerators</h3> @* Изменил цвет на danger для соответствия *@
                    </div>
                </div>
            </div>
        </div>
        
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 border-0">
                <div class="row align-items-center">
                    <div class="col">
                        <h5 class="mb-0 fw-bold text-secondary">Список учетных записей</h5>
                    </div>
                    @if (canInsert)
                    {
                        <div class="col-auto">
                            <button class="btn btn-primary d-flex align-items-center shadow-sm" @onclick="OpenAddModal">
                                <i class="bi bi-person-plus-fill me-2"></i> Добавить модератора
                            </button>
                        </div>
                    }
                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <TableView TItem="ModeratorListItemVm"
                                  StorageKey="Moderators"
                                  Data="pagedModerators"
                                  Columns="columns"
                                  Query="_query"
                                  OnQueryChanged="LoadData"/>
                </div>
            </div>
        </div>
    </div>
</AccessControl>



@* 1. СОЗДАНИЕ *@
@if (showAddModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold">Новый модератор</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => showAddModal = false"></button>
                </div>
                <EditForm Model="createModel" OnValidSubmit="HandleCreate">
                    <DataAnnotationsValidator />
                    <div class="modal-body p-4">
                        @* Поле выбора в модалке создания *@
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Филиалы (выберите один или несколько)</label>
                            <div class="d-flex flex-wrap gap-2 mb-2 p-2 border rounded bg-light min-vh-10">
                                @if (createModel.BranchesUuids == null || !createModel.BranchesUuids.Any())
                                {
                                    <span class="text-muted small">Ничего не выбрано</span>
                                }
                                else
                                {
                                    @foreach (var id in createModel.BranchesUuids)
                                    {
                                        var branch = allBranches.FirstOrDefault(b => b.Uuid == id);
                                        <span class="badge bg-primary d-flex align-items-center">
                                            @branch?.Name
                                            <button type="button" class="btn-close btn-close-white ms-2" @onclick="() => createModel.BranchesUuids.Remove(id)"></button>
                                        </span>
                                    }
                                }
                            </div>
                            <select class="form-select" @onchange="@((ChangeEventArgs e) => AddBranchToModel(createModel.BranchesUuids, e))">
                                <option value="">-- Добавить филиал --</option>
                                @foreach (var b in allBranches.Where(x => !createModel.BranchesUuids.Contains(x.Uuid)))
                                {
                                    <option value="@b.Uuid">@b.Name</option>
                                }
                            </select>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Логин</label>
                            <div class="input-group">
                                <input class="form-control bg-light" @bind="createModel.Login" type="text" />
                                <button type="button" class="btn btn-outline-secondary" @onclick="GenerateLogin">Ген.</button>
                            </div>
                            <ValidationMessage For="@(() => createModel.Login)" class="text-danger small" />
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Пароль</label>
                            <div class="input-group">
                                <input class="form-control bg-light" @bind="createModel.PlainPassword" type="text" />
                                <button type="button" class="btn btn-outline-secondary" @onclick="GeneratePassword">Ген.</button>
                            </div>
                            <ValidationMessage For="@(() => createModel.PlainPassword)" class="text-danger small" />
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted">Фамилия</label>
                            <InputText @bind-Value="createModel.Surname" class="form-control"/>
                            <ValidationMessage For="@(() => createModel.Surname)"/>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted">Имя</label>
                            <InputText @bind-Value="createModel.Name" class="form-control"/>
                            <ValidationMessage For="@(() => createModel.Name)"/>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted">Отчество</label>
                            <InputText @bind-Value="createModel.Patronymic" class="form-control"/>
                            <ValidationMessage For="@(() => createModel.Patronymic)"/>
                        </div>
                        
                    </div>
                    <div class="modal-footer bg-light border-0">
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="() => showAddModal = false">Отмена</button>
                        <button type="submit" class="btn btn-primary btn-sm px-4" disabled="@isProcessing">
                            @if (isProcessing) { <span class="spinner-border spinner-border-sm me-2"></span> }
                            Создать
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@* 2. РЕДАКТИРОВАНИЕ *@
@if (showEditModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Редактирование: @editModel.Login</h5>
                    <button type="button" class="btn-close" @onclick="() => showEditModal = false"></button>
                </div>
                <EditForm Model="editModel" OnValidSubmit="HandleUpdate">
                    <DataAnnotationsValidator />
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Логин</label>
                            <input class="form-control bg-light" @bind="editModel.Login" />
                            <ValidationMessage For="@(() => editModel.Login)" />
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted">Фамилия</label>
                            <InputText @bind-Value="editModel.Surname" class="form-control"/>
                            <ValidationMessage For="@(() => editModel.Surname)"/>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted">Имя</label>
                            <InputText @bind-Value="editModel.Name" class="form-control"/>
                            <ValidationMessage For="@(() => editModel.Name)"/>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted">Отчество</label>
                            <InputText @bind-Value="editModel.Patronymic" class="form-control"/>
                            <ValidationMessage For="@(() => editModel.Patronymic)"/>
                        </div>
                        
                        @* Поле выбора в модалке создания *@
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Филиалы (выберите один или несколько)</label>
                            <div class="d-flex flex-wrap gap-2 mb-2 p-2 border rounded bg-light min-vh-10">
                                @if (editModel.BranchesUuids == null || !editModel.BranchesUuids.Any())
                                {
                                    <span class="text-muted small">Ничего не выбрано</span>
                                }
                                else
                                {
                                    @foreach (var id in editModel.BranchesUuids)
                                    {
                                        var branch = allBranches.FirstOrDefault(b => b.Uuid == id);
                                        <span class="badge bg-primary d-flex align-items-center">
                                            @branch?.Name
                                            <button type="button" class="btn-close btn-close-white ms-2" @onclick="() => editModel.BranchesUuids.Remove(id)"></button>
                                        </span>
                                    }
                                }
                            </div>
                            <select class="form-select" @onchange="@((ChangeEventArgs e) => AddBranchToModel(editModel.BranchesUuids, e))">
                                <option value="">-- Добавить филиал --</option>
                                @foreach (var b in allBranches.Where(x => !editModel.BranchesUuids.Contains(x.Uuid)))
                                {
                                    <option value="@b.Uuid">@b.Name</option>
                                }
                            </select>
                        </div>
                        
                        <div class="form-check form-switch mt-4">
                            <input class="form-check-input" type="checkbox" @bind="editModel.IsActive" id="activeSwitch">
                            <label class="form-check-label fw-bold" for="activeSwitch">Аккаунт активен</label>
                        </div>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="() => showEditModal = false">Закрыть</button>
                        <button type="submit" class="btn btn-primary btn-sm" disabled="@isProcessing">Сохранить</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}



<ResetPasswordModal @bind-Password="plainPassword"
                    IsVisible="showResetModal"
                    IsSaved="isSaved"
                    OnConfirm="HandleResetPassword"
                    OnClose="CancelReset" 
                    ErrorMessage="@errorMessage"/>

<ConfirmDeleteModal 
    IsVisible="showDeleteModal"
    Title="Удалить модератора?"
    ItemName="@selectedLogin"
    IsProcessing="isProcessing"
    OnConfirm="HandleDelete"
    OnCancel="() => showDeleteModal = false"
    ErrorMessage="@errorMessage"/>

<UserPermissionsModal 
    Show="showPermsModal"
    UserLogin="@selectedLogin"
    Permissions="@permissions"
    OnClose="() => showPermsModal = false"
    OnSave="SavePermissions"
    IsProcessing="isProcessing" />

@* (Модалки для Reset Password и Permissions делаются идентично Administrators.razor) *@
@code {
    private bool isLoaded;
    private bool isProcessing;
    private bool canRead, canInsert, canUpdate, canDelete;

    private PagedResult<ModeratorListItemVm> pagedModerators = new();
    private List<TableColumn<ModeratorListItemVm>> columns = new();
    private ModeratorStatsVm? stats;
    private TableQuery _query = new() { PageSize = 10 };
    private List<TablePermissionVm> permissions = new();
    private List<BranchNamesLookupVm> allBranches = new();

    // Состояния модалок
    private bool showAddModal, showEditModal, showDeleteModal, showResetModal, showPermsModal;
    
    // Модели
    private CreateModeratorVm createModel = new();
    private EditModeratorVm editModel = new();
    private Guid selectedUuid, resetUuid;
    private string selectedLogin = "";
    private string plainPassword = "";
    private bool isSaved;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var userId = UserSessionAccessor.UserUuid;
        if (userId.HasValue)
        {
            canRead = await UserSessionAccessor.HasPermission(DbSchemaConstants.Moderators, SqlOperation.Select);
            canInsert = await UserSessionAccessor.HasPermission(DbSchemaConstants.Moderators, SqlOperation.Insert);
            canUpdate = await UserSessionAccessor.HasPermission(DbSchemaConstants.Moderators, SqlOperation.Update);
            canDelete = await UserSessionAccessor.HasPermission(DbSchemaConstants.Moderators, SqlOperation.Delete);
        }

        if (canRead)
        {
            await LoadInitialData();
        }
        
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("search", out var searchValue))
        {
            _query.Search = searchValue;
            await LoadData(_query);
        }
        
        isLoaded = true;
    }

    private async Task LoadInitialData()
    {
        allBranches = await BranchService.GetAllBranchesAsync();
        DefineTableColumns();
        await LoadStats();
        await LoadData(_query);
    }
    
    private void DefineTableColumns()
    {
        columns =
        [
            new TableColumn<ModeratorListItemVm> { Title = "UUID", Value = a => a.Uuid.ToString(), Sortable = false, SortKey = "uuid" },
            new TableColumn<ModeratorListItemVm> { Title = "Логин", Value = a => a.Login, Sortable = false, SortKey = "login" },
            new TableColumn<ModeratorListItemVm> 
            { 
                Title = "Организация", 
                Value = a => a.OrganizationName,
                Sortable = false, 
                SortKey = "organization_name",
                Template = (item) => (builder) => 
                {
                    var url = $"/organizations?search={item.OrganizationUuid}";
                    builder.OpenElement(0, "a");
                    builder.AddAttribute(1, "href", url);
                    builder.AddAttribute(2, "class", "badge bg-primary text-decoration-none me-1");
                    builder.AddContent(3, item.OrganizationName);
                    builder.CloseElement();
                }
            },
            new TableColumn<ModeratorListItemVm>
            {
                Title = "Филиалы",
                Value = a => a.BranchesNames,
                Sortable = false,
                SortKey = "branches_name",
                Template = (item) => (builder) =>
                {
                    if (item.BranchesUuids == null || item.BranchesUuids.Count == 0) return;

                    var names = item.BranchesNames?.Split(", ") ?? [];

                    for (var i = 0; i < item.BranchesUuids.Count; i++)
                    {
                        var uuid = item.BranchesUuids[i];
                        var name = i < names.Length ? names[i] : uuid.ToString();

                        builder.OpenElement(0, "a");
                        builder.AddAttribute(1, "href", $"/branches?search={uuid}");
                        builder.AddAttribute(2, "class", "badge bg-primary text-decoration-none me-1");
                        builder.AddContent(3, name);
                        builder.CloseElement();
                    }
                }
            },

            new TableColumn<ModeratorListItemVm> { Title = "Статус", Value = a => a.IsActive ? "Активен" : "Заблокирован", Sortable = true, SortKey = "is_active" },
            new TableColumn<ModeratorListItemVm> { Title = "Дата создания", Value = a => a.CreatedAt.ToString("dd.MM.yyyy HH:mm"), Sortable = true, SortKey = "created_at" },
            new TableColumn<ModeratorListItemVm> { Title = "Фамилия", Value = a => a.Surname, Sortable = false, SortKey = "surname" },
            new TableColumn<ModeratorListItemVm> { Title = "Имя", Value = a => a.Name, Sortable = false, SortKey = "name" },
            new TableColumn<ModeratorListItemVm> { Title = "Отчество", Value = a => a.Patronymic, Sortable = false, SortKey = "patronymic" }

        ];
        
        if (canUpdate || canDelete)
        {
            columns.Add(new TableColumn<ModeratorListItemVm>
            {
                Title = "Действия",
                Sortable = false,
                Template = moderator => @<div class="btn-group btn-group-sm">
                                            @if (canUpdate)
                                            {
                                                <button class="btn btn-outline-primary" @onclick="() => OpenEditModal(moderator)" title="Редактировать"><i class="bi bi-pencil"></i></button>
                                                <button class="btn btn-outline-info" @onclick="() => OpenPermissions(moderator)" title="Права"><i class="bi bi-shield-lock"></i></button>
                                                <button class="btn btn-outline-secondary" @onclick="() => OpenResetPassword(moderator)" title="Пароль"><i class="bi bi-key"></i></button>
                                            }
                                            @if (canDelete)
                                            {
                                                <button class="btn btn-outline-danger" @onclick="() => ConfirmDelete(moderator)" title="Удалить"><i class="bi bi-trash"></i></button>
                                            }
                                        </div>
            });
        }
    }

    private async Task LoadStats() => stats = await ModeratorService.GetStatsAsync();

    private async Task LoadData(TableQuery q)
    {
        _query = q;
        pagedModerators = await ModeratorService.GetPagedAsync(_query);
    }

    private async Task HandleSearch() => await LoadData(_query);

    // --- ДЕЙСТВИЯ ---
    private void AddBranchToModel(List<Guid> list, ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var branchId))
        {
            if (!list.Contains(branchId))
            {
                list.Add(branchId);
            }
        }
    }

    private void OpenAddModal()
    {
        createModel = new() {BranchesUuids = new List<Guid>()};
        showAddModal = true;
    }

    private async Task HandleCreate()
    {
        isProcessing = true;
        var result = await ModeratorService.CreateAsync(createModel);
        if (result.IsSuccess)
        {
            showAddModal = false;
            await LoadInitialData();
        }
        isProcessing = false;
    }

    private void OpenEditModal(ModeratorListItemVm mod)
    {
        editModel = new EditModeratorVm 
        { 
            Uuid = mod.Uuid, 
            Login = mod.Login, 
            IsActive = mod.IsActive, 
            Surname = mod.Surname,
            Name = mod.Name,
            Patronymic = mod.Patronymic,
            BranchesUuids = mod.BranchesUuids
        };
        showEditModal = true;
    }

    private async Task HandleUpdate()
    {
        isProcessing = true;
        var result = await ModeratorService.UpdateAsync(editModel);
        if (result.IsSuccess)
        {
            showEditModal = false;
            await LoadData(_query);
        }
        isProcessing = false;
    }

    private void ConfirmDelete(ModeratorListItemVm mod)
    {
        selectedUuid = mod.Uuid;
        selectedLogin = mod.Login;
        showDeleteModal = true;
        errorMessage = null;
    }

    private async Task HandleDelete()
    {
        isProcessing = true;
        var result = await ModeratorService.DeleteAsync(selectedUuid);
        if (result.IsSuccess)
        {
            showDeleteModal = false;
            await LoadInitialData();
        }
        else
        {
            // Выводим текст ошибки из результата сервиса
            // В зависимости от вашего DeleteUserResult, свойство может называться Message или Error
            errorMessage = result.ErrorCode; 
        }
        isProcessing = false;
    }
    
    private void GeneratePassword() => createModel.PlainPassword = UsersDataGenerator.GeneratePassword();
    private void GenerateLogin() => createModel.Login = UsersDataGenerator.GenerateLogin("moder_");
    
    
    private void OpenResetPassword(ModeratorListItemVm moderator)
    {
        if (canUpdate)
        {
            resetUuid = moderator.Uuid;
            plainPassword = "";
            isSaved = false;
            showResetModal = true;
        }
    }
    
    private void CancelReset()
    {
        showResetModal = false;
    }

    private async Task HandleResetPassword()
    {
        if (!canUpdate || string.IsNullOrWhiteSpace(plainPassword)) return;
        isProcessing = true;
        await ModeratorService.ResetPasswordAsync(resetUuid, plainPassword);
        isSaved = true;
        isProcessing = false;
    }


    private async Task OpenPermissions(ModeratorListItemVm moderator)
    {
        if (canUpdate)
        {
            selectedLogin = moderator.Login;
            selectedUuid = moderator.Uuid;
            permissions = await UserPermissions.GetPermissionsAsync(moderator.Uuid, false);
            showPermsModal = true;
        }
    }

    private async Task SavePermissions(List<TablePermissionVm> perms)
    {
        if (!canUpdate) return;
        isProcessing = true;
        await UserPermissions.UpdatePermissionsAsync(selectedUuid, perms);
        showPermsModal = false;
        isProcessing = false;
    }


}