@page "/courses"
<PageTitle>Курсы</PageTitle>
@using LMS.Components.Shared
@using LMS.Components.Shared.CardsView
@using LMS.DTOs.CardsView
@using LMS.Services
@using LMS.DTOs.Course
@using LMS.DTOs.TableView
@using LMS.Interfaces
@using LMS.Models.Database
@rendermode InteractiveServer
@inject UserRequestContext UserRequestContext
@inject ISubscriptionService SubscriptionService
@inject ICourseService CourseService
@inject NavigationManager NavigationManager

<AccessControl IsLoaded="_isLoaded" CanRead="_canRead" PageName="Курсы">
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold">Каталог курсов</h2>
            @if (_canInsert)
            {
                <button class="btn btn-primary">Создать курс</button>
            }
        </div>

        <CardsView TItem="CourseListItemVm"
                   Data="_page"
                   Query="_query"
                   OnQueryChanged="HandleQueryChanged"
                   IsLoading="!_isLoaded"
                   StorageKey="Courses"
                   SortOptions="_sortOptions"
                   FilterDisplayNames="_filterDisplayNames">
            
            <FilterTemplates>
                <div class="filter-item p-2 border rounded bg-light">
                    <MultiSelectFilter Title="Категория"
                                       FilterKey="category"
                                       Options="_categories"
                                       Query="_query"
                                       OnChanged="HandleQueryChanged" />
                </div>

                <div class="filter-item p-2 border rounded bg-light">
                    <MultiSelectFilter Title="Автор"
                                       FilterKey="author"
                                       Options="_authors"
                                       Query="_query"
                                       OnChanged="HandleQueryChanged" />
                </div>
            </FilterTemplates>
            
            <CardTemplate>
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <span class="badge mb-2 me-2"
                              style="background-color: @context.CategoryColor">@context.CategoryName</span>

                        @if (_availableCourses != null && _availableCourses.Contains(context.Uuid))
                        {
                            <span class="badge bg-success mb-2">Доступен в подписке!</span>
                        }
                        <h5 class="card-title fw-bold">@context.Name</h5>
                        <p class="card-text text-muted small">@context.ShortDescription</p>
                    </div>
                    <div class="card-footer bg-white border-0 d-flex justify-content-between align-items-center">
                        <small class="text-muted"><i class="bi bi-person"></i> Загрузил: @context.AuthorName</small>
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => NavigateToCourse(context.Uuid)">
                            Подробнее
                        </button>
                    </div>

                    @if (context.UpdatedAt.HasValue)
                    {
                        <div class="card-footer">
                            <small class="text-muted">
                                <i class="bi bi-pencil-square"></i>
                                Последнее изменение: @context.UpdatedAt.Value.ToString("dd.MM.yyyy HH:mm")
                            </small>
                        </div>
                    }
                    else
                    {
                        <div class="card-footer">
                            <small class="text-muted">
                                Дата создания: @context.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                            </small>
                        </div>
                    }
                </div>
            </CardTemplate>
        </CardsView>
    </div>
</AccessControl>


@code {
    private bool _canRead;
    private bool _canInsert;
    private bool _isLoaded;
    private bool _isLoading;

    private List<string> _categories = [];
    private List<string> _authors = [];

    private PagedResult<CourseListItemVm> _page = new();
    private List<Guid>? _availableCourses;

    private CardQuery _query = new()
    {
        Page = 1,
        PageSize = 9
    };

    private readonly Dictionary<string, string> _sortOptions = new()
    {
        { "name", "По названию" },
        { "create_date", "По дате создания" },
        { "category", "По категории" }
    };

    private readonly Dictionary<string, string> _filterDisplayNames = new()
    {
        { "category", "Категория" },
        { "author", "Автор" },
        { "subscription", "В подписке" }
    };

    protected override async Task OnInitializedAsync()
    {
        if (!UserRequestContext.UserUuid.HasValue)
            return;

        _canRead = await UserRequestContext.HasPermission(
            DbSchemaConstants.Courses, SqlOperation.Select);

        _canInsert = await UserRequestContext.HasPermission(
            DbSchemaConstants.Courses, SqlOperation.Insert);

        if (_canRead)
        {
            await LoadData();

            _categories = _page.Items?.Select(c => c.CategoryName).Distinct().ToList() ?? [];
            _authors = _page.Items?.Select(c => c.AuthorName).Distinct().ToList() ?? [];
        }

        _isLoaded = true;
    }

    private async Task LoadData()
    {
        _isLoading = true;
        _page = await CourseService.GetCoursesForCardsAsync(_query);
        
        
        if (UserRequestContext.UserRole == "Moderator" && UserRequestContext.ActiveBranchUuid.HasValue)
        {
            _availableCourses = await SubscriptionService.GetAllAvailableCourses((Guid)UserRequestContext.ActiveBranchUuid);
        }
        
        _isLoading = false;
    }

    private async Task HandleQueryChanged(CardQuery query)
    {
        _query = query;
        await LoadData();
        StateHasChanged();
    }

    private void NavigateToCourse(Guid uuid)
    {
        NavigationManager.NavigateTo($"/courses/{uuid}");
    }

}