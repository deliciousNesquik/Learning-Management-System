@page "/login"
<PageTitle>Авторизация</PageTitle>
@inject NavigationManager Nav
@rendermode InteractiveServer

<div class="login-container">
    <div class="card login-card shadow border-0">
        <div class="card-header text-center py-4">
            <h3 class="fw-bold mb-0">СДО</h3>
            <small class="text-muted">Система дистанционного обучения</small>
        </div>

        <div class="card-body p-4">
            <form action="account/login" method="post">
                <AntiforgeryToken />

                @if (!string.IsNullOrEmpty(Error))
                {
                    <div class="alert alert-danger py-2 small animate-shake">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        @TranslateError(Error)
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label">Логин</label>
                    <input name="login"
                           class="form-control form-control-lg"
                           placeholder="user_01"
                           required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Пароль</label>
                    <input name="password"
                           type="password"
                           class="form-control form-control-lg"
                           placeholder="••••••"
                           required />
                </div>

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="form-check">
                        <input class="form-check-input"
                               type="checkbox"
                               name="rememberMe"
                               id="rememberMe" />
                        <label class="form-check-label" for="rememberMe">
                            Запомнить меня
                        </label>
                    </div>
                </div>

                <button type="submit"
                        class="btn btn-primary w-100 py-2 fw-semibold">
                    Войти
                </button>
            </form>
        </div>
    </div>
</div>

<style>
    .login-container {
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f4f6f8; /* мягкий серо-белый */
    }

    .login-card {
        width: 100%;
        max-width: 420px;
        border-radius: 14px;
        background: #fbfcfd; /* «дорогой» белый */
    }

    .login-card .card-header {
        background: transparent;
        border-bottom: none;
    }
</style>

@code {
    [SupplyParameterFromQuery(Name = "Error")]
    public string? Error { get; set; }

    private string TranslateError(string errorCode) => errorCode switch
    {
        "ERR_INVALID_CREDENTIALS" => "Неверный логин или пароль",
        "ERR_NO_ORGANIZATION" => "Ваш аккаунт не привязан ни к одной организации",
        "ERR_SUBSCRIPTION_EXPIRED" => "Доступ закрыт: подписка организации истекла",
        "true" => "Произошла ошибка при входе", // На случай старых редиректов ?Error=true
        _ => "Произошла непредвиденная ошибка"
    };
}