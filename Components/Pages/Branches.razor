@page "/branches"
@using LMS.Components.Shared
@using LMS.Components.Table
@using LMS.Interfaces
@using LMS.Models
@using LMS.Services
@using LMS.ViewModels.BranchViewModel
@using LMS.ViewModels.OrganizationViewModel
@using Microsoft.AspNetCore.Authorization
@rendermode InteractiveServer
@inject UserSessionAccessor UserSessionAccessor
@inject NavigationManager NavigationManager
@inject UserPermissions UserPermissions
@inject IBranchService BranchService
@inject IOrganizationService OrganizationService

@attribute [Authorize(Roles = "Admin")]

@if (!_isLoaded)
{
    <div class="d-flex justify-content-center align-items-center" style="height: 50vh;">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else if (!_canRead)
{
    <div class="container mt-5">
        <div class="alert alert-danger shadow-sm border-0 d-flex align-items-center p-4">
            <i class="bi bi-shield-lock-fill fs-1 me-4"></i>
            <div>
                <h4 class="alert-heading fw-bold">Доступ ограничен</h4>
                <p class="mb-0">У вас недостаточно прав для просмотра раздела "Филиалы".</p>
                <button class="btn btn-outline-danger btn-sm mt-3" @onclick='() => NavigationManager.NavigateTo("/")'>На главную</button>
            </div>
        </div>
    </div>
}
else
{
    <div class="container-fluid px-4 mt-3 animate-fade-in">

        @* Таблица *@
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 border-0">
                <div class="row align-items-center">
                    <div class="col">
                        <h5 class="mb-0 fw-bold text-secondary">Список всех филиалов</h5>
                    </div>
                    @if (_canInsert)
                    {
                        <div class="col-auto">
                            <button class="btn btn-primary d-flex align-items-center shadow-sm" @onclick="OpenAddModal">
                                <i class="bi bi-person-plus-fill me-2"></i> Добавить филиал
                            </button>
                        </div>
                    }
                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <GenericTable TItem="BranchListItemVm"
                                  Data="_page"
                                  Columns="_columns"
                                  Query="_query"
                                  OnQueryChanged="LoadData"/>
                </div>
            </div>
        </div>
    </div>
}

@* 1. СОЗДАНИЕ *@
@if (_showAddModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold">Новый филиал</h5>
                </div>
                <EditForm Model="_createModel" OnValidSubmit="HandleCreate">
                    <DataAnnotationsValidator />
                    <div class="modal-body p-4">
                        
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Организация</label>
                            <InputSelect @bind-Value="_createModel.OrganizationUuid" class="form-select bg-light">
                                <option value="">-- Выберите организацию --</option>
                                @foreach (var form in allOrganizations)
                                {
                                    <option value="@form.Uuid">@form.Name</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => _createModel.OrganizationUuid)" class="text-danger small" />
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Название</label>
                            <input class="form-control bg-light" @bind="_createModel.Name" placeholder="Название"/>
                            <ValidationMessage For="@(() => _createModel.Name)" class="text-danger small"/>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label small fw-bold">По умолчанию</label>
                            <InputCheckbox @bind-Value="_createModel.IsDefault" class="form-check-input" id="editActive"/>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Код филиала</label>
                            <input class="form-control bg-light" @bind="_createModel.BranchCode" placeholder="Код филиала"/>
                            <ValidationMessage For="@(() => _createModel.BranchCode)" class="text-danger small"/>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Часовой пояс</label>
                            <input class="form-control bg-light" @bind="_createModel.Timezone" placeholder="Часовой пояс"/>
                            <ValidationMessage For="@(() => _createModel.Timezone)" class="text-danger small"/>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Регион / Область / Республика</label>
                            <input class="form-control bg-light" @bind="_createModel.Region" placeholder="Регион / Область / Республика"/>
                            <ValidationMessage For="@(() => _createModel.Region)" class="text-danger small"/>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Город</label>
                            <input class="form-control bg-light" @bind="_createModel.City" placeholder="Город"/>
                            <ValidationMessage For="@(() => _createModel.City)" class="text-danger small"/>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Улица</label>
                            <input class="form-control bg-light" @bind="_createModel.Street" placeholder="Улица"/>
                            <ValidationMessage For="@(() => _createModel.Street)" class="text-danger small"/>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Номер дома</label>
                            <input class="form-control bg-light" @bind="_createModel.HouseNumber" placeholder="Номер дома"/>
                            <ValidationMessage For="@(() => _createModel.HouseNumber)" class="text-danger small"/>
                        </div>

                    </div>
                    <div class="modal-footer bg-light border-0">
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="() => _showAddModal = false">Отмена</button>
                        <button type="submit" class="btn btn-primary btn-sm px-4" disabled="@isProcessing">
                            @if (isProcessing) { <span class="spinner-border spinner-border-sm me-2"></span> }
                            Создать
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@* 2. РЕДАКТИРОВАНИЕ *@
@if (_showEditModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold">Редактирование: @selectedName</h5>
                </div>
                <EditForm Model="_editModel" OnValidSubmit="HandleUpdate">
                    <DataAnnotationsValidator />
                    <div class="modal-body p-4">
                        
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Организация</label>
                            <InputSelect @bind-Value="_editModel.OrganizationUuid" class="form-select bg-light">
                                <option value="">-- Выберите организацию --</option>
                                @foreach (var form in allOrganizations)
                                {
                                    <option value="@form.Uuid">@form.Name</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => _editModel.OrganizationUuid)" class="text-danger small" />
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Название</label>
                            <input class="form-control bg-light" @bind="_editModel.Name" placeholder="Название"/>
                            <ValidationMessage For="@(() => _editModel.Name)" class="text-danger small"/>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label small fw-bold">По умолчанию</label>
                            <InputCheckbox @bind-Value="_editModel.IsDefault" class="form-check-input" id="editActive"/>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Статус</label>
                            <InputCheckbox @bind-Value="_editModel.Status" class="form-check-input" id="editActive"/>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Код филиала</label>
                            <input class="form-control bg-light" @bind="_editModel.BranchCode" placeholder="Код филиала"/>
                            <ValidationMessage For="@(() => _editModel.BranchCode)" class="text-danger small"/>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Часовой пояс</label>
                            <input class="form-control bg-light" @bind="_editModel.Timezone" placeholder="Часовой пояс"/>
                            <ValidationMessage For="@(() => _editModel.Timezone)" class="text-danger small"/>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Регион / Область / Республика</label>
                            <input class="form-control bg-light" @bind="_editModel.Region" placeholder="Регион / Область / Республика"/>
                            <ValidationMessage For="@(() => _editModel.Region)" class="text-danger small"/>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Город</label>
                            <input class="form-control bg-light" @bind="_editModel.City" placeholder="Город"/>
                            <ValidationMessage For="@(() => _editModel.City)" class="text-danger small"/>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Улица</label>
                            <input class="form-control bg-light" @bind="_editModel.Street" placeholder="Улица"/>
                            <ValidationMessage For="@(() => _editModel.Street)" class="text-danger small"/>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Номер дома</label>
                            <input class="form-control bg-light" @bind="_editModel.HouseNumber" placeholder="Номер дома"/>
                            <ValidationMessage For="@(() => _editModel.HouseNumber)" class="text-danger small"/>
                        </div>

                    </div>
                    <div class="modal-footer bg-light border-0">
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="() => _showEditModal = false">Отмена</button>
                        <button type="submit" class="btn btn-primary btn-sm px-4" disabled="@isProcessing">
                            @if (isProcessing) { <span class="spinner-border spinner-border-sm me-2"></span> }
                            Сохранить
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<ConfirmDeleteModal 
    IsVisible="_showDeleteModal"
    Title="Удалить филиал?"
    ItemName="@selectedName"
    IsProcessing="isProcessing"
    OnConfirm="HandleDelete"
    OnCancel="() => _showDeleteModal = false"
    ErrorMessage="@errorMessage"/>

@code {
    private bool _isLoaded;
    private bool isProcessing;
    private bool _canRead, _canInsert, _canUpdate, _canDelete;
    
    private TableQuery _query = new() { PageSize = 10 };
    private PagedResult<BranchListItemVm> _page = new();
    private List<TableColumn<BranchListItemVm>> _columns = new();
    private List<OrganizationNamesLookupVm> allOrganizations = new();
    
    // Состояния модалок
    private bool _showAddModal, _showEditModal, _showDeleteModal;
    
    // Модели
    private CreateBranchVm _createModel = new();
    private EditBranchVm _editModel = new();
    private Guid selectedUuid;
    private string selectedFullName = "";
    private bool isSaved;
    private Guid _selectedUuid;
    private string selectedName = "";
    private string? errorMessage;
    
    protected override async Task OnInitializedAsync()
    {
        var userId = UserSessionAccessor.UserUuid;
        if (userId.HasValue)
        {
            _canRead = await UserSessionAccessor.HasPermission(DbSchemaConstants.Branches, SqlOperation.Select);
            _canInsert = await UserSessionAccessor.HasPermission(DbSchemaConstants.Branches, SqlOperation.Insert);
            _canUpdate = await UserSessionAccessor.HasPermission(DbSchemaConstants.Branches, SqlOperation.Update);
            _canDelete = await UserSessionAccessor.HasPermission(DbSchemaConstants.Branches, SqlOperation.Delete);
        }

        if (_canRead)
        {
            await LoadInitialData();
        }
        _isLoaded = true;
    }

    private async Task LoadInitialData()
    {
        allOrganizations = await OrganizationService.GetAllOrganizationsNamesAsync();
        DefineTableColumns();
        await LoadData(_query);
    }
    
    private void DefineTableColumns()
    {
        _columns =
        [
            new() { Title = "UUID", Value = a => a.Uuid.ToString(), Sortable = true, SortKey = "uuid" },
            new() { Title = "Филиал", Value = a => a.Name, Sortable = true, SortKey = "name" },
            new() { Title = "Организация", Value = a => a.OrganizationName, Sortable = true, SortKey = "organization_name" },
            new() { Title = "По умолчанию", Value = a => (a.IsDefault == true ? "Да" : "Нет"), Sortable = true, SortKey = "is_default" },
            new() { Title = "Код филиала", Value = a => a.BranchCode, Sortable = true, SortKey = "branch_code" },
            new() { Title = "Состояние", Value = a => a.Status ? "Активен" : "Отключен", Sortable = true, SortKey = "status" },
            new() { Title = "Регион", Value = a => a.Region, Sortable = true, SortKey = "region" },
            new() { Title = "Город", Value = a => a.City, Sortable = true, SortKey = "city" },  
            new() { Title = "Улица", Value = a => a.Street, Sortable = true, SortKey = "street" },
            new() { Title = "Дом", Value = a => a.HouseNumber, Sortable = true, SortKey = "house_number" },
            new() { Title = "Когда создано", Value = a => a.CreatedAt, Sortable = true, SortKey = "created_at" },
            new() { Title = "Часовой пояс", Value = a => a.Timezone, Sortable = true, SortKey = "timezone" },
        ];
        
        if (_canUpdate || _canDelete)
        {
            _columns.Add(new TableColumn<BranchListItemVm>
            {
                Title = "Действия",
                Sortable = false,
                Template = branch => @<div class="btn-group btn-group-sm">
                    @if (_canUpdate) { <button class="btn btn-outline-primary" @onclick="() => OpenEditModal(branch)" title="Редактировать"><i class="bi bi-pencil"></i></button> }
                    @if (_canDelete) { <button class="btn btn-outline-danger" @onclick="() => ConfirmDelete(branch)" title="Удалить"><i class="bi bi-trash"></i></button> }
                </div>
            });
        }
    }

    private async Task LoadData(TableQuery q)
    {
        _query = q;
        _page = await BranchService.GetPagedAsync(_query);
    }
    
    private void OpenAddModal()
    {
        _createModel = new CreateBranchVm() {};
        _showAddModal = true;
    }
    
    private async Task HandleCreate()
    {
        isProcessing = true;
        var result = await BranchService.CreateAsync(_createModel);
        if (result.IsSuccess)
        {
            _showAddModal = false;
            await LoadInitialData();
        }
        isProcessing = false;
    }

    private void OpenEditModal(BranchListItemVm mod)
    {
        selectedName = mod.Name;
        _editModel = new EditBranchVm() 
        { 
            Uuid = mod.Uuid,
            OrganizationUuid = mod.OrganizationUuid,
            Name = mod.Name,
            BranchCode = mod.BranchCode,
            Status = mod.Status,
            IsDefault = mod.IsDefault,
            Region = mod.Region,
            City = mod.City,
            Street = mod.Street,
            HouseNumber = mod.HouseNumber,
            Timezone = mod.Timezone
        };
        _showEditModal = true;
    }

    private async Task HandleUpdate()
    {
        isProcessing = true;
        var result = await BranchService.UpdateAsync(_editModel);
        if (result.IsSuccess)
        {
            _showEditModal = false;
            await LoadData(_query);
        }
        isProcessing = false;
    }

    private void ConfirmDelete(BranchListItemVm mod)
    {
        _selectedUuid = mod.Uuid;
        selectedName = mod.Name;
        _showDeleteModal = true;
        errorMessage = null;
    }

    private async Task HandleDelete()
    {
        isProcessing = true;
        var result = await BranchService.DeleteAsync(_selectedUuid);
        if (result.IsSuccess)
        {
            _showDeleteModal = false;
            await LoadInitialData();
        }
        else
        {
            // Выводим текст ошибки из результата сервиса
            // В зависимости от вашего DeleteUserResult, свойство может называться Message или Error
            errorMessage = result.ErrorCode; 
        }
        isProcessing = false;
    }
}