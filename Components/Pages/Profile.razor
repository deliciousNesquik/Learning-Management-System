@page "/profile"
@using LMS.Interfaces
@using LMS.Services
@using LMS.Models
@inject UserSessionAccessor Accessor
@inject IUserSecurityService UserSecurityService
@inject IJSRuntime JS

@rendermode InteractiveServer

<div class="container-fluid px-3">
    <div class="row justify-content-center">
        <div class="col-xl-9 col-lg-10 col-md-12">
            <div class="profile-container mx-auto">
                
                <div class="card shadow-sm border-0 rounded-3">
                    <div class="card-header bg-primary text-white py-2">
                        <h6 class="mb-0 fw-semibold text-center">Мой профиль</h6>
                    </div>
                    
                    <div class="card-body p-3">
                        <div class="text-center mb-3">
                            <div class="position-relative d-inline-block mb-2">
                                <div class="rounded-circle bg-light d-flex align-items-center justify-content-center" 
                                     style="width: 75px; height: 75px; font-size: 1.4rem; color: #0d6efd; font-weight: 600; text-transform: uppercase;">
                                    <span>@($"{Accessor.UserName?.FirstOrDefault()}{Accessor.UserSurname?.FirstOrDefault()}".ToUpper())</span>
                                </div>
                            </div>

                            <h6 class="fw-bold mb-1 text-dark">
                                @Accessor.UserSurname @Accessor.UserName @Accessor.UserPatronymic
                            </h6>
                            <div class="mb-2">
                                <span class="badge @GetRoleBadgeClass() px-2 py-1 fw-medium fs-7">
                                    <i class="bi bi-person me-1 fs-7"></i> @GetLocalizedRole()
                                </span>
                            </div>
                        </div>

                        <div class="row g-2">
                            <div class="col-12">
                                <div class="mb-2">
                                    <label class="form-label text-muted mb-1 fs-7 fw-medium">Логин</label>
                                    <div class="input-group">
                                        <span class="form-control bg-light border-1 fw-medium px-2 py-1">@Accessor.UserLogin</span>
                                        <button class="btn btn-outline-primary btn-sm px-2 py-1" type="button"
                                                @onclick="() => CopyToClipboard(Accessor.UserLogin)" 
                                                title="Копировать">
                                            <i class="bi bi-clipboard fs-6"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="mb-2">
                                    <label class="form-label text-muted mb-1 fs-7 fw-medium">Идентификатор (UUID)</label>
                                    <div class="input-group">
                                        <span class="form-control bg-light border-1 text-truncate fw-medium px-2 py-1" 
                                              style="font-family: monospace; font-size: 0.78rem;">@Accessor.UserUuid</span>
                                        <button class="btn btn-outline-primary btn-sm px-2 py-1" type="button" 
                                                @onclick="() => CopyToClipboard(Accessor.UserUuid.ToString())" 
                                                title="Копировать">
                                            <i class="bi bi-clipboard fs-6"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="card shadow-sm border-0 rounded-3" style="margin-top: 30px">
                    <div class="card-header bg-primary text-white py-2">
                        <h6 class="mb-0 fw-semibold text-center">Безопасность</h6>
                    </div>
                    
                    <div class="card-body p-3">
                        <div class="mb-3">
                            <label class="form-label text-muted mb-1 fs-7 fw-medium">Последняя смена пароля</label>
                            @if (lastPasswordChangeDate.HasValue)
                            {
                                <div class="d-flex align-items-center justify-content-between bg-light p-2 rounded">
                                    <span class="fw-medium">@lastPasswordChangeDate.Value.ToString("dd.MM.yyyy HH:mm")</span>
                                    <span class="badge bg-success-subtle text-success fs-7"> Изменен</span>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-between bg-light p-2 rounded">
                                    <span class="badge bg-danger text-white fs-7">Требуется смена пароля</span>
                                </div>
                            }
                        </div>

                        <div class="d-grid">
                            <button class="btn btn-primary btn-sm py-2" type="button"
                                    @*@onclick="ChangePasswordAsync"*@>
                                <i class="bi bi-key me-1"></i> Сменить пароль
                            </button>
                        </div>

                        @if (!string.IsNullOrEmpty(passwordChangeMessage))
                        {
                            <div class="mt-2 alert alert-info p-2 mb-0 rounded">
                                <i class="bi bi-info-circle me-1"></i> @passwordChangeMessage
                            </div>
                        }
                    </div>
                </div>
                
            </div>
        </div>
    </div>
</div>

<style>
    .profile-container {
        width: 90%;
        max-width: 1140px;
        margin: 30px auto;
    }
    
    .card-header {
        background-color: #0d6efd !important;
        min-height: 36px;
    }
    
    .bg-light {
        background-color: #f8f9fa !important;
    }
    
    .border-1 {
        border-width: 1px !important;
        border-color: #dee2e6 !important;
    }
    
    .btn-outline-primary {
        border-color: #0d6efd !important;
        color: #0d6efd !important;
        padding: 0.25rem 0.4rem !important;
    }
    
    .btn-outline-primary:hover {
        background-color: #0d6efd !important;
        color: white !important;
    }
    
    .badge-admin {
        background-color: #0d6efd;
        color: white;
    }
    
    .badge-moderator {
        background-color: #6c757d;
        color: white;
    }
    
    .badge-employee {
        background-color: #198754;
        color: white;
    }
    
    .badge-default {
        background-color: #6c757d;
        color: white;
    }
    
    .fs-7 {
        font-size: 0.85rem !important;
    }
    
    .card {
        border: 1px solid #e9ecef !important;
    }
    
    .shadow-sm {
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075) !important;
    }
</style>

@code {
    private DateTime? lastPasswordChangeDate;
    private string passwordChangeMessage = string.Empty;
    
    private string GetLocalizedRole()
    {
        return Accessor.UserRole switch
        {
            "Admin" => "Администратор",
            "Moderator" => "Куратор",
            "Employee" => "Обучающийся",
            _ => "Пользователь"
        };
    }
    
    protected override async Task OnInitializedAsync()
    {
        await LoadPasswordChangeDateAsync();
    }

    private async Task LoadPasswordChangeDateAsync()
    {
        try
        {
            // isLoading = true;
            StateHasChanged();
            
            lastPasswordChangeDate = await UserSecurityService.GetLastPasswordChangeDateAsync((Guid)Accessor.UserUuid);
            Console.WriteLine(lastPasswordChangeDate);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка загрузки данных о пароле: {ex.Message}");
            lastPasswordChangeDate = null;
            passwordChangeMessage = "Не удалось загрузить данные о последней смене пароля";
            //alertClass = "alert-danger";
            //iconClass = "bi bi-exclamation-triangle";
        }
        finally
        {
            //isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ChangePasswordAsync()
    {
        StateHasChanged();
    }

    private string GetRoleBadgeClass()
    {
        return Accessor.UserRole switch
        {
            "Admin" => "badge-admin",
            "Moderator" => "badge-moderator",
            "Employee" => "badge-employee",
            _ => "badge-default"
        };
    }

    private async Task CopyToClipboard(string? text)
    {
        if (string.IsNullOrEmpty(text)) return;
        
        try {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        }
        catch (Exception ex) {
            Console.WriteLine($"Ошибка копирования: {ex.Message}");
        }
    }
}