@using LMS.Components.Shared
@using LMS.Components.Table
@using LMS.Data.Models
@using LMS.Interfaces
@using LMS.Services
@using LMS.ViewModels.OrganizationViewModel
@using Microsoft.AspNetCore.Authorization

@page "/organizations"
@rendermode InteractiveServer

@inject UserSessionAccessor UserSessionAccessor
@inject IOrganizationService OrganizationService
@inject NavigationManager NavigationManager
@inject UserPermissions UserPermissions

@attribute [Authorize(Roles = "Admin")]

@if (!_isLoaded)
{
    <div class="d-flex justify-content-center align-items-center" style="height: 50vh;">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else if (!_canRead)
{
    <div class="container mt-5">
        <div class="alert alert-danger shadow-sm border-0 d-flex align-items-center p-4">
            <i class="bi bi-shield-lock-fill fs-1 me-4"></i>
            <div>
                <h4 class="alert-heading fw-bold">Доступ ограничен</h4>
                <p class="mb-0">У вас недостаточно прав для просмотра раздела "Организации".</p>
                <button class="btn btn-outline-danger btn-sm mt-3" @onclick='() => NavigationManager.NavigateTo("/")'>На главную</button>
            </div>
        </div>
    </div>
}
else
{
    <div class="container-fluid px-4 mt-3 animate-fade-in">

        @* Таблица *@
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 border-0">
                <div class="row align-items-center">
                    <div class="col">
                        <h5 class="mb-0 fw-bold text-secondary">Список всех организаций</h5>
                    </div>
                    @if (_canInsert)
                    {
                        <div class="col-auto">
                            <button class="btn btn-primary d-flex align-items-center shadow-sm" @onclick="OpenAddModal">
                                <i class="bi bi-person-plus-fill me-2"></i> Добавить организацию
                            </button>
                        </div>
                    }
                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <GenericTable TItem="OrganizationListItemVm"
                                  Data="_page"
                                  Columns="columns"
                                  Query="_query"
                                  OnQueryChanged="LoadData"/>
                </div>
            </div>
        </div>
    </div>
}

@* 1. СОЗДАНИЕ *@
@if (_showAddModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold">Новая организация</h5>
                </div>
                <EditForm Model="_createModel" OnValidSubmit="HandleCreate">
                    <DataAnnotationsValidator />
                    <div class="modal-body p-4">
                        
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Правовая форма</label>
                            <InputSelect @bind-Value="_createModel.LegalFormUuid" class="form-select bg-light">
                                <option value="">-- Выберите форму --</option>
                                @if (orgList != null)
                                {
                                    @foreach (var form in orgList)
                                    {
                                        <option value="@form.Uuid">@form.Name</option>
                                    }
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => _createModel.LegalFormUuid)" class="text-danger small" />
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Название</label>
                            <input class="form-control bg-light" @bind="_createModel.Name" placeholder="Название"/>
                            <ValidationMessage For="@(() => _createModel.Name)" class="text-danger small"/>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Почта</label>
                            <input class="form-control bg-light" @bind="_createModel.Mail" placeholder="Почта организации"/>
                            <ValidationMessage For="@(() => _createModel.Mail)" class="text-danger small"/>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Контакты</label>
                            <input class="form-control bg-light" @bind="_createModel.Contacts" placeholder="Контакты организации"/>
                            <ValidationMessage For="@(() => _createModel.Contacts)" class="text-danger small"/>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label small fw-bold">ИНН</label>
                            <input class="form-control bg-light" @bind="_createModel.TaxPayer" placeholder="ИНН организации"/>
                            <ValidationMessage For="@(() => _createModel.TaxPayer)" class="text-danger small"/>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label small fw-bold">№ лицензии</label>
                            <input class="form-control bg-light" @bind="_createModel.LicenseNumber" placeholder="Номер лицензии"/>
                            <ValidationMessage For="@(() => _createModel.LicenseNumber)" class="text-danger small"/>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Дата начала лицензии</label>
                            <input class="form-control bg-light" @bind="_createModel.LicenseValidFrom" placeholder="Дата начала лицензии"/>
                            <ValidationMessage For="@(() => _createModel.LicenseNumber)" class="text-danger small"/>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Дата окончания лицензии</label>
                            <input class="form-control bg-light" @bind="_createModel.LicenseValidTo" placeholder="Дата окончания лицензии"/>
                            <ValidationMessage For="@(() => _createModel.LicenseValidTo)" class="text-danger small"/>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Регион / Область / Республика</label>
                            <input class="form-control bg-light" @bind="_createModel.Region" placeholder="Регион / Область / Республика"/>
                            <ValidationMessage For="@(() => _createModel.Region)" class="text-danger small"/>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Город</label>
                            <input class="form-control bg-light" @bind="_createModel.City" placeholder="Город"/>
                            <ValidationMessage For="@(() => _createModel.City)" class="text-danger small"/>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Улица</label>
                            <input class="form-control bg-light" @bind="_createModel.Street" placeholder="Улица"/>
                            <ValidationMessage For="@(() => _createModel.Street)" class="text-danger small"/>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Номер дома</label>
                            <input class="form-control bg-light" @bind="_createModel.HouseNumber" placeholder="Номер дома"/>
                            <ValidationMessage For="@(() => _createModel.HouseNumber)" class="text-danger small"/>
                        </div>

                    </div>
                    <div class="modal-footer bg-light border-0">
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="() => _showAddModal = false">Отмена</button>
                        <button type="submit" class="btn btn-primary btn-sm px-4" disabled="@isProcessing">
                            @if (isProcessing) { <span class="spinner-border spinner-border-sm me-2"></span> }
                            Создать
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

