                            <InputSelect @bind-Value="_editModel.LegalFormUuid" class="form-select bg-light">
                                <option value="">-- Выберите форму --</option>
                                @foreach (var form in orgList)
                                {
                                    <option value="@form.Uuid">@form.Name</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => _createModel.LegalFormUuid)" class="text-danger small" />
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Название</label>
                            <input class="form-control bg-light" @bind="_editModel.Name" placeholder="Название"/>
                            <ValidationMessage For="@(() => _editModel.Name)" class="text-danger small"/>
                        </div>
                        
