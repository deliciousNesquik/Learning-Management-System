                            <input class="form-control bg-light" @bind="_editModel.Contacts" placeholder="Контакты организации"/>
                            <ValidationMessage For="@(() => _editModel.Contacts)" class="text-danger small"/>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label small fw-bold">ИНН</label>
                            <input class="form-control bg-light" @bind="_editModel.TaxPayer" placeholder="ИНН организации"/>
                            <ValidationMessage For="@(() => _editModel.TaxPayer)" class="text-danger small"/>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label small fw-bold">№ лицензии</label>
                            <input class="form-control bg-light" @bind="_editModel.LicenseNumber" placeholder="Номер лицензии"/>
                            <ValidationMessage For="@(() => _editModel.LicenseNumber)" class="text-danger small"/>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label small fw-bold">Дата начала лицензии</label>
