}

<ConfirmDeleteModal 
    IsVisible="_showDeleteModal"
    Title="Удалить модератора?"
    ItemName="@selectedName"
    IsProcessing="isProcessing"
    OnConfirm="HandleDelete"
    OnCancel="() => _showDeleteModal = false"
    ErrorMessage="@errorMessage"/>

@code {
    private bool _isLoaded;
    private bool isProcessing;
    private bool _canRead, _canInsert, _canUpdate, _canDelete;
    
    private TableQuery _query = new() { PageSize = 10 };
    private PagedResult<OrganizationListItemVm> _page = new();
    public List<TableColumn<OrganizationListItemVm>> columns = new();
    private List<LegalFormLookupVm> orgList = new();
    
    // Состояния модалок
    private bool _showAddModal, _showEditModal, _showDeleteModal;
    
    // Модели
    private CreateOrganizationVm _createModel = new();
    private EditOrganizationVm _editModel = new();
    private Guid _selectedUuid;
    private string selectedName = "";
    private bool isSaved;
    private string? errorMessage;
    
    protected override async Task OnInitializedAsync()
    {
        var userId = UserSessionAccessor.UserUuid;
        if (userId.HasValue)
        {
            _canRead = await UserPermissions.HasPermission(userId, "organizations", "select");
            _canInsert = await UserPermissions.HasPermission(userId, "organizations", "insert");
            _canUpdate = await UserPermissions.HasPermission(userId, "organizations", "update");
            _canDelete = await UserPermissions.HasPermission(userId, "organizations", "delete");
        }

        if (_canRead)
        {
            await LoadInitialData();
        }
        _isLoaded = true;
    }

    private async Task LoadInitialData()
    {
        // Загружаем список организаций для выпадающего списка
        orgList = await OrganizationService.GetLegalFormsAsync();
        DefineTableColumns();
        await LoadData(_query);
    }
    
    private void DefineTableColumns()
    {
        columns =
        [
            new() { Title = "UUID", Value = a => a.Uuid.ToString(), Sortable = true, SortKey = "uuid" },
            new() { Title = "Форма организации", Value = a => a.LegalFormName, Sortable = true, SortKey = "legal_form" },
            new() { Title = "Название", Value = a => a.Name, Sortable = true, SortKey = "name" },
            new() { Title = "ИНН", Value = a => a.Taxpayer, Sortable = true, SortKey = "taxpayer" },
            new() { Title = "Почта", Value = a => a.Mail, Sortable = true, SortKey = "mail" },
            new() { Title = "Контакты", Value = a => a.Contacts, Sortable = true, SortKey = "contacts" },
            new() { Title = "Регион", Value = a => a.Region, Sortable = true, SortKey = "region" },
            new() { Title = "Город", Value = a => a.City, Sortable = true, SortKey = "city" },
            new() { Title = "Улица", Value = a => a.Street, Sortable = true, SortKey = "street" },
            new() { Title = "Дом", Value = a => a.HouseNumber, Sortable = true, SortKey = "house_number" },
            new() { Title = "Кол-во филиалов", Value = a => a.CountBranches, Sortable = true, SortKey = "count_branches" },
            
        ];
        
        if (_canUpdate || _canDelete)
        {
            columns.Add(new TableColumn<OrganizationListItemVm>
            {
                Title = "Действия",
                Sortable = false,
                Template = organization => @<div class="btn-group btn-group-sm">
                    @if (_canUpdate) { <button class="btn btn-outline-primary" @onclick="() => OpenEditModal(organization)" title="Редактировать"><i class="bi bi-pencil"></i></button> }
                    @if (_canDelete) { <button class="btn btn-outline-danger" @onclick="() => ConfirmDelete(organization)" title="Удалить"><i class="bi bi-trash"></i></button> }
                </div>
            });
        }
    }

    private async Task LoadData(TableQuery q)
    {
        _query = q;
        _page = await OrganizationService.GetPagedAsync(_query);
    }
    
    // --- ДЕЙСТВИЯ ---
    
    private void OpenAddModal()
    {
        _createModel = new CreateOrganizationVm() {};
        _showAddModal = true;
    }
    
    private async Task HandleCreate()
    {
        isProcessing = true;
        var result = await OrganizationService.CreateAsync(_createModel);
        if (result.IsSuccess)
        {
            _showAddModal = false;
            await LoadInitialData();
        }
        isProcessing = false;
    }

    private void OpenEditModal(OrganizationListItemVm mod)
    {
        selectedName = mod.Name;
        _editModel = new EditOrganizationVm() 
        { 
            Uuid = mod.Uuid,
            Name = mod.Name,
            Mail = mod.Mail,
            Contacts = mod.Contacts,
            TaxPayer = mod.Taxpayer,
            LegalFormUuid = mod.LegalFormUuid,
            Region = mod.Region,
            City = mod.City,
            Street = mod.Street,
            HouseNumber = mod.HouseNumber
        };
        _showEditModal = true;
    }

    private async Task HandleUpdate()
    {
        isProcessing = true;
        var result = await OrganizationService.UpdateAsync(_editModel);
        if (result.IsSuccess)
        {
            _showEditModal = false;
            await LoadData(_query);
        }
        isProcessing = false;
    }

    private void ConfirmDelete(OrganizationListItemVm mod)
    {
        _selectedUuid = mod.Uuid;
        selectedName = mod.Name;
        _showDeleteModal = true;
        errorMessage = null;
    }

    private async Task HandleDelete()
    {
        isProcessing = true;
        var result = await OrganizationService.DeleteAsync(_selectedUuid);
        if (result.IsSuccess)
        {
            _showDeleteModal = false;
            await LoadInitialData();
        }
        else
        {
            // Выводим текст ошибки из результата сервиса
            // В зависимости от вашего DeleteUserResult, свойство может называться Message или Error
            errorMessage = result.ErrorCode; 
        }
        isProcessing = false;
    }
}