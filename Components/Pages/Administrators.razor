@page "/administrators"
@using LMS.Components.Shared
@using LMS.Components.Table
@using LMS.DTOs
@using LMS.DTOs.Admin
@using LMS.DTOs.General
@using LMS.Infrastructure.Security
@using LMS.Interfaces
@using LMS.Models
@using LMS.Models.Database
@using LMS.Services
@using Microsoft.AspNetCore.Authorization
@inject IAdminService AdminService
@inject UserPermissions UserPermissions
@inject UserSessionAccessor UserSessionAccessor
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer

@attribute [Authorize(Roles = "Admin")]

<AccessControl IsLoaded="_isLoaded" CanRead="_canRead" PageName="Администраторы">
    <div class="container-fluid px-4 mt-3 animate-fade-in">
        @* Статистика *@
        <div class="row mb-4">
            <div class="col-md-4">
                <div class="card border-0 border-start border-primary border-4 shadow-sm bg-white h-100">
                    <div class="card-body">
                        <h6 class="text-muted small fw-bold text-uppercase">Всего администраторов</h6>
                        <h3 class="mb-0">@_totalCount</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 border-start border-success border-4 shadow-sm bg-white h-100">
                    <div class="card-body">
                        <h6 class="text-muted small fw-bold text-uppercase text-success">Активных</h6>
                        <h3 class="mb-0 text-success">@_activeCount</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 border-start border-warning border-4 shadow-sm bg-white h-100">
                    <div class="card-body">
                        <h6 class="text-muted small fw-bold text-uppercase text-warning">Заблокированных</h6>
                        <h3 class="mb-0 text-warning">@_blockCount</h3>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 border-0">
                <div class="row align-items-center">
                    <div class="col">
                        <h5 class="mb-0 fw-bold text-secondary">Список учетных записей</h5>
                    </div>
                    @if (_canInsert)
                    {
                        <div class="col-auto">
                            <button class="btn btn-primary d-flex align-items-center shadow-sm" @onclick="OpenAddModal">
                                <i class="bi bi-person-plus-fill me-2"></i> Добавить администратора
                            </button>
                        </div>
                    }
                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <GenericTable TItem="AdminListItemVm"
                                  StorageKey="Administrators"
                                  Data="_page"
                                  Columns="_columns"
                                  Query="_query"
                                  OnQueryChanged="LoadData"/>
                </div>
            </div>
        </div>
    </div>
</AccessControl>


@* МОДАЛЬНОЕ ОКНО ДОБАВЛЕНИЯ *@
@if (_showAddModal && _canInsert)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.6); backdrop-filter: blur(2px);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header @(_isSaved ? "bg-success" : "bg-primary") text-white border-0">
                    <h5 class="modal-title w-100 text-center fw-bold">
                        <i class="bi @(_isSaved ? "bi-shield-check" : "bi-person-plus-fill") me-2"></i>
                        @(_isSaved ? "Данные созданы" : "Новый администратор")
                    </h5>
                </div>
                @if (!_isSaved)
                {
                    <EditForm Model="@_createModel" OnValidSubmit="HandleCreate">
                        <DataAnnotationsValidator/>
                        <div class="modal-body p-4">
                            
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Логин</label>
                                <div class="input-group">
                                    <input class="form-control bg-light" @bind="_createModel.Login" type="text" />
                                    <button type="button" class="btn btn-outline-secondary" @onclick="GenerateLogin">Ген.</button>
                                </div>
                                <ValidationMessage For="@(() => _createModel.Login)" class="text-danger small" />
                            </div>
                            
                            <div class="mb-3">
                                <label class="form-label small fw-bold">Пароль</label>
                                <div class="input-group">
                                    <input class="form-control bg-light" @bind="_createModel.PlainPassword" type="text" />
                                    <button type="button" class="btn btn-outline-secondary" @onclick="GeneratePassword">Ген.</button>
                                </div>
                                <ValidationMessage For="@(() => _createModel.PlainPassword)" class="text-danger small" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold small text-muted">Фамилия</label>
                                <InputText @bind-Value="_createModel.Surname" class="form-control"/>
                                <ValidationMessage For="@(() => _createModel.Surname)"/>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold small text-muted">Имя</label>
                                <InputText @bind-Value="_createModel.Name" class="form-control"/>
                                <ValidationMessage For="@(() => _createModel.Name)"/>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold small text-muted">Отчество</label>
                                <InputText @bind-Value="_createModel.Patronymic" class="form-control"/>
                                <ValidationMessage For="@(() => _createModel.Patronymic)"/>
                            </div>


                            @* --- БЛОК ОШИБКИ --- *@
                            @if (!string.IsNullOrEmpty(_errorMessage))
                            {
                                <div class="alert alert-danger small py-2" role="alert">
                                    <i class="bi bi-x-circle me-2"></i> @_errorMessage
                                </div>
                            }
                        </div>
                        
                        <div class="modal-footer bg-light border-0 justify-content-center p-3">
                            <button type="button" class="btn btn-outline-secondary px-4" @onclick="CloseAddModal">Отмена</button>
                            
                            <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm" disabled="@_isProcessing">
                                @if (_isProcessing) { <span class="spinner-border spinner-border-sm me-2"></span> } Сохранить
                            </button>
                        </div>
                    </EditForm>
                }
                else
                {
                    <div class="modal-body p-4">
                        <div class="alert alert-warning border-0 small mb-4">
                            <strong>Внимание:</strong> Сохраните эти данные сейчас.
                        </div>
                        <div class="list-group list-group-flush border rounded shadow-sm">
                            <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                                <div><small class="text-muted d-block">Логин</small><span class="fw-bold">@_createModel.Login</span></div>
                                <button class="btn btn-sm btn-light border" @onclick='() => CopyToClipboard(_createModel.Login)'><i class="bi bi-clipboard"></i></button>
                            </div>
                            <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                                <div><small class="text-muted d-block">Пароль</small><code class="fw-bold">@_createModel.PlainPassword</code></div>
                                <button class="btn btn-sm btn-light border" @onclick='() => CopyToClipboard(_createModel.PlainPassword)'><i class="bi bi-clipboard"></i></button>
                            </div>
                        </div>
                        <button class="btn btn-success w-100 mt-4 fw-bold" @onclick="CloseAddModal">Готово</button>
                    </div>
                }
            </div>
        </div>
    </div>
}

@* МОДАЛЬНОЕ ОКНО РЕДАКТИРОВАНИЯ *@
@if (_showEditModal && _editModel != null && _canUpdate)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5); backdrop-filter: blur(2px);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-primary text-white border-0">
                    <h5 class="modal-title w-100 text-center fw-bold">Редактирование: @_editModel.Login</h5>
                </div>
                <EditForm Model="@_editModel" OnValidSubmit="HandleUpdate">
                    <DataAnnotationsValidator/>
                    <div class="modal-body p-4">
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted">ЛОГИН</label>
                            <InputText @bind-Value="_editModel.Login" class="form-control"/>
                            <ValidationMessage For="@(() => _editModel.Login)"/>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted">Фамилия</label>
                            <InputText @bind-Value="_editModel.Surname" class="form-control"/>
                            <ValidationMessage For="@(() => _editModel.Surname)"/>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted">Имя</label>
                            <InputText @bind-Value="_editModel.Name" class="form-control"/>
                            <ValidationMessage For="@(() => _editModel.Name)"/>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold small text-muted">Отчество</label>
                            <InputText @bind-Value="_editModel.Patronymic" class="form-control"/>
                            <ValidationMessage For="@(() => _editModel.Patronymic)"/>
                        </div>

                        <div class="form-check form-switch">
                            <label class="form-check-label" for="editActive">Возможность пользоваться платформой</label>
                            <InputCheckbox @bind-Value="_editModel.IsActive" class="form-check-input" id="editActive"/>
                        </div>

                        @* --- БЛОК ОШИБКИ --- *@
                        @if (!string.IsNullOrEmpty(_errorMessage))
                        {
                            <div class="alert alert-danger small py-2" role="alert">
                                <i class="bi bi-x-circle me-2"></i> @_errorMessage
                            </div>
                        }
                    </div>
                    
                    <div class="modal-footer border-0">
                        <button type="button" class="btn btn-light" @onclick="() => _showEditModal = false">Отмена</button>
                        <button type="submit" class="btn btn-primary px-4 fw-bold" disabled="@_isProcessing">Сохранить</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<ResetPasswordModal @bind-Password="_plainPassword"
                    IsVisible="_showResetModal"
                    IsSaved="_isSaved"
                    OnConfirm="HandleResetPassword"
                    OnClose="CancelReset" 
                    ErrorMessage="@_errorMessage"/>

<ConfirmDeleteModal 
    IsVisible="_showDeleteModal"
    Title="Удалить администратора?"
    ItemName="@_selectedObjectTitle"
    IsProcessing="_isProcessing"
    OnConfirm="HandleDelete"
    OnCancel="() => _showDeleteModal = false"
    ErrorMessage="@_errorMessage"/>

<UserPermissionsModal 
    Show="_showPermissionModal"
    UserLogin="@_selectedObjectTitle"
    Permissions="@_listAvailablePermissions"
    OnClose="() => _showPermissionModal = false"
    OnSave="SavePermissions"
    IsProcessing="_isProcessing" />

<style>
    .animate-fade-in { animation: fadeIn 0.3s ease-in-out; }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>

@code {
    [SupplyParameterFromQuery(Name = "Search")]
    public string? Search { get; set; }
    
    private TableQuery _query = new();
    private PagedResult<AdminListItemVm> _page = new();
    private List<TableColumn<AdminListItemVm>> _columns = [];
    private EditAdminVm? _editModel;
    private CreateAdminVm? _createModel = new();
    private List<TablePermissionVm> _listAvailablePermissions = [];
    
    
    // Флаги состояния и прав
    private bool _isLoaded;
    private bool _canRead, _canInsert, _canUpdate, _canDelete;
    private bool _isSaved, _isProcessing;
    
    // Контекст для страницы чтобы было понятие какое модельное окно показать.
    private bool _showAddModal, 
        _showEditModal, 
        _showResetModal, 
        _showDeleteModal, 
        _showPermissionModal;
    
    private string? _errorMessage, _plainPassword, _selectedObjectTitle;
    private Guid? _selectedObjectUuid;
    private int _totalCount, _activeCount, _blockCount;
    

    protected override async Task OnInitializedAsync()
    {
        var userId = UserSessionAccessor.UserUuid;
        if (userId.HasValue)
        {
            _canRead = await UserSessionAccessor.HasPermission(DbSchemaConstants.Administrators, SqlOperation.Select);
            _canUpdate = await UserSessionAccessor.HasPermission(DbSchemaConstants.Administrators, SqlOperation.Update);
            _canInsert = await UserSessionAccessor.HasPermission(DbSchemaConstants.Administrators, SqlOperation.Insert);
            _canDelete = await UserSessionAccessor.HasPermission(DbSchemaConstants.Administrators, SqlOperation.Delete);

            if (_canRead)
            {
                DefineTableColumns();
                await LoadStats();
                
                if (Search != null)
                    _query.Search = Search;
        
                await LoadData(_query);
            }
        }
        
        _isLoaded = true;
    }

    private TableColumn<AdminListItemVm> CreateDataColumn(string title, Func<AdminListItemVm,object?> value, bool sortable, string sortKey)
    {
        return new TableColumn<AdminListItemVm>
        {
            Title = title,
            Value = value,
            Sortable = sortable,
            SortKey = sortKey
        };
    }
    
    private void DefineTableColumns()
    {
        _columns =
        [
            CreateDataColumn("UUID", a => a.Uuid, false, "uuid"),
            CreateDataColumn("Логин", a => a.Login, true, "login"),
            CreateDataColumn("Статус", a => a.IsActive ? "Активен" : "Заблокирован", true, "status"),
            CreateDataColumn("Фамилия", a => a.Surname, false, "surname"),
            CreateDataColumn("Имя", a => a.Name, false, "name"),
            CreateDataColumn("Отчество", a => a.Patronymic, false, "patronymic"),
            CreateDataColumn("Дата создания", a => a.CreatedAt.ToString("dd.MM.yyyy HH:mm"), true, "created_at")
        ];
        
        if (_canUpdate || _canDelete)
        {
            _columns.Add(new TableColumn<AdminListItemVm>
            {
                Title = "Действия",
                Sortable = false,
                Template = admin => @<div class="btn-group btn-group-sm">
                                        @if (_canUpdate)
                                        {
                                            <button class="btn btn-outline-primary" @onclick="() => OpenEditModal(admin)" title="Редактировать"><i class="bi bi-pencil"></i></button>
                                            <button class="btn btn-outline-info" @onclick="() => OpenPermissions(admin)" title="Права"><i class="bi bi-shield-lock"></i></button>
                                            <button class="btn btn-outline-secondary" @onclick="() => OpenResetPassword(admin)" title="Пароль"><i class="bi bi-key"></i></button>
                                        }
                                        @if (_canDelete)
                                        {
                                            <button class="btn btn-outline-danger" @onclick="() => ConfirmDelete(admin)" title="Удалить"><i class="bi bi-trash"></i></button>
                                        }
                                    </div>
            });
        }
    }

    private async Task LoadData(TableQuery q)
    {
        if (!_canRead) return;
        _query = q;
        _page = await AdminService.GetPagedAsync(_query = q);
    }

    private async Task LoadStats()
    {
        if (!_canRead) return;
        var stats = await AdminService.GetStatsAsync();
        _totalCount = stats.Total;
        _activeCount = stats.Active;
        _blockCount = stats.Blocked;
    }

    private void OpenAddModal()
    {
        _errorMessage = null;
        if (!_canInsert)
        {
            _errorMessage = "Ошибка доступа. У вас нет прав на создание.";
            return;
        }
        _createModel = new CreateAdminVm(); 
        _errorMessage = null; 
        _isSaved = false; 
        _showAddModal = true;
    }
    
    private async Task HandleCreate()
    {
        if (!_canInsert)
        {
            _errorMessage = "Ошибка доступа. У вас нет прав на создание.";
            return;
        }
        _isProcessing = true;
        try
        {
            if (_createModel != null)
            {
                var result = await AdminService.CreateAsync(_createModel);
                if (result.IsSuccess)
                {
                    _isSaved = true; await LoadData(_query); await LoadStats();
                }
                else
                {
                    _errorMessage = result.ErrorCode;
                }
            }
            else
            {
                _errorMessage = "Ошибка на стороне сервера. Пожалуйста перезагрузите страницу и попробуйте заново. Если не поможет обратитесь в поддержку";
            }
        }
        catch { _errorMessage = "Ошибка на стороне сервера. Пожалуйста перезагрузите страницу и попробуйте заново. Если не поможет обратитесь в поддержку"; }
        finally { _isProcessing = false; }
    }
    
    private void OpenEditModal(AdminListItemVm admin)
    {
        _errorMessage = null;
        if (!_canUpdate)
        {
            _errorMessage = "Ошибка доступа. У вас нет прав на изменение.";
            return;
        }
        _editModel = new EditAdminVm
        {
            Uuid = admin.Uuid, 
            Login = admin.Login, 
            IsActive = admin.IsActive, 
            Surname = admin.Surname, 
            Name = admin.Name, 
            Patronymic = admin.Patronymic
        };
        _showEditModal = true;
    }

    private async Task HandleUpdate()
    {
        if (!_canInsert)
        {
            _errorMessage = "Ошибка доступа. У вас нет прав на изменение.";
            return;
        }
        
        _isProcessing = true;
        try
        {
            if (_editModel != null)
            {
                var result = await AdminService.UpdateAsync(_editModel);
                if (result.IsSuccess)
                {
                    _showEditModal = false;
                    await LoadData(_query); await LoadStats();
                }
                else
                {
                    _errorMessage = result.ErrorCode;
                }
            }
            else
            {
                _errorMessage = "Ошибка на стороне сервера. Пожалуйста перезагрузите страницу и попробуйте заново. Если не поможет обратитесь в поддержку";
            }
        }
        catch { _errorMessage = "Ошибка на стороне сервера. Пожалуйста перезагрузите страницу и попробуйте заново. Если не поможет обратитесь в поддержку"; }
        finally { _isProcessing = false; }
    }

    private void GeneratePassword()
    {
        if (_createModel == null)
        {
            _errorMessage = "Произошла ошибка! Пожалуйста перезагрузите страницу!";
            return;
        }
        _createModel.PlainPassword = UsersDataGenerator.GeneratePassword();
    }

    private void GenerateLogin()
    {
        if (_createModel == null)
        {
            _errorMessage = "Произошла ошибка! Пожалуйста перезагрузите страницу!";
            return;
        }
        _createModel.Login = UsersDataGenerator.GenerateLogin("admin_");
    }
    
    private void OpenResetPassword(AdminListItemVm admin)
    {
        _errorMessage = null;
        if (!_canUpdate)
        {
            _errorMessage = "Ошибка доступа. У вас нет прав на изменение пароля.";
            return;
        }
        
        _selectedObjectUuid = admin.Uuid; 
        _plainPassword = ""; 
        _isSaved = false; 
        _showResetModal = true;
    }

    private void CancelReset() => _showResetModal = false;

    private async Task HandleResetPassword()
    {
        if (!_canUpdate || string.IsNullOrWhiteSpace(_plainPassword) || !_selectedObjectUuid.HasValue)
        {
            _errorMessage = "Произошла ошибка...";
            return;
        }
        _isProcessing = true;
        
        var result = await AdminService.ResetPasswordAsync((Guid)_selectedObjectUuid, _plainPassword);
        if (result.IsSuccess)
        {
            _isSaved = true;
            _isProcessing = false;
            StateHasChanged();
        }
        else
        {
            _errorMessage = result.ErrorCode;
            _isSaved = false;
            _isProcessing = false;
        }
        
    }
    
    private async Task HandleDelete()
    {
        _errorMessage = null;
        if (!_canDelete)
        {
            _errorMessage = "Ошибка доступа. У вас нет прав на удаление.";
            return;
        }
        try
        {
            if (_selectedObjectUuid != null)
            {
                var result = await AdminService.DeleteAsync((Guid)_selectedObjectUuid);
                if (result.IsSuccess)
                {
                    _showDeleteModal = false;
                    await LoadData(_query); await LoadStats();
                }
                else
                {
                    _errorMessage = result.ErrorCode;
                }
            }
            else
            {
                _errorMessage = "Ошибка на стороне сервера. Пожалуйста перезагрузите страницу и попробуйте заново. Если не поможет обратитесь в поддержку";
            }
        }
        catch { _errorMessage = "Ошибка на стороне сервера. Пожалуйста перезагрузите страницу и попробуйте заново. Если не поможет обратитесь в поддержку"; }
        finally { _isProcessing = false; }
    }
    
    private void ConfirmDelete(AdminListItemVm admin)
    {
        if (!_canDelete)
        {
            _errorMessage = "Ошибка доступа. У вас нет прав на удаление.";
            return;
        }

        try
        {
            _selectedObjectUuid = admin.Uuid;
            _selectedObjectTitle = admin.Login;
        }
        catch (NullReferenceException)
        {
            _errorMessage = "Ошибка получения данных. Пожалуйста перезагрузите страницу и попробуйте заново. Если не поможет обратитесь в поддержку";
        }
        finally
        {
            _showDeleteModal = true;
            _errorMessage = null;
        }
        
    }
    

    // --- ПРАВА ---
    private async Task OpenPermissions(AdminListItemVm admin)
    {
        if (_canUpdate)
        {
            try
            {
                _selectedObjectTitle = admin.Login;
                _selectedObjectUuid = admin.Uuid;

                if (_selectedObjectUuid != null)
                {
                    _listAvailablePermissions = await UserPermissions.GetPermissionsAsync((Guid)_selectedObjectUuid, true);
                    _showPermissionModal = true;
                }
                else
                {
                    _errorMessage = "Ошибка на стороне сервера. Пожалуйста перезагрузите страницу и попробуйте заново. Если не поможет обратитесь в поддержку";
                }
            }
            catch (NullReferenceException)
            {
                _errorMessage = "Ошибка получения данных. Пожалуйста перезагрузите страницу и попробуйте заново. Если не поможет обратитесь в поддержку";
            }
        }
    }

    private async Task SavePermissions(List<TablePermissionVm> perms)
    {
        if (!_canUpdate) return;

        if (_selectedObjectUuid == null)
        {
            _errorMessage = "Ошибка получения данных. Пожалуйста перезагрузите страницу и попробуйте заново. Если не поможет обратитесь в поддержку";
            return;
        }
        _isProcessing = true;
        await UserPermissions.UpdatePermissionsAsync((Guid)_selectedObjectUuid, perms);
        _showPermissionModal = false;
        _isProcessing = false;
    }

    private async Task CopyToClipboard(string text)
    {
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
    }


    private void CloseAddModal()
    {
        _showAddModal = false;
        _isSaved = false;
    }
}