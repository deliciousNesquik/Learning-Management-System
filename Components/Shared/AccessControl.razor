@inject NavigationManager NavigationManager

@if (!IsLoaded)
{
    <div class="d-flex justify-content-center align-items-center" style="height: 50vh;">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else if (!CanRead)
{
    <div class="container mt-5">
        <div class="alert alert-danger shadow-sm border-0 d-flex align-items-center p-4">
            <i class="bi bi-shield-lock-fill fs-1 me-4"></i>
            <div>
                <h4 class="alert-heading fw-bold">Доступ ограничен</h4>
                <p class="mb-0">У вас недостаточно прав для просмотра раздела "@PageName".</p>
                <button class="btn btn-outline-danger btn-sm mt-3" @onclick='() => NavigationManager.NavigateTo("/")'>
                    На главную
                </button>
            </div>
        </div>
    </div>
}
else
{
    @ChildContent
}

@code {
    [Parameter] public bool IsLoaded { get; set; }
    [Parameter] public bool CanRead { get; set; }
    [Parameter] public string PageName { get; set; } = "данного раздела";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}