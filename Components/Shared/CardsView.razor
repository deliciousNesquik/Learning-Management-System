@using System.Collections
@using System.Threading
@using LMS.DTOs.CardsView
@using LMS.DTOs.TableView
@using LMS.Interfaces
@typeparam TItem
@inject IStorageService Storage

<div class="cards-grid-container">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">

        <div class="d-flex align-items-center gap-3 flex-grow-1">
            <div class="position-relative w-50" style="min-width: 250px;">
                <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                <input class="form-control ps-5 border-1 shadow-none"
                       placeholder="Поиск..."
                       value="@_searchText"
                       @oninput="HandleSearchInput"/>
                @if (!string.IsNullOrEmpty(_searchText))
                {
                    <button class="btn btn-link position-absolute top-50 end-0 translate-middle-y text-muted p-2"
                            @onclick="ClearSearch">
                        <i class="bi bi-x-lg"></i>
                    </button>
                }
            </div>

            <div class="d-flex align-items-center gap-2">
                <span class="text-nowrap small text-muted">Карточек на странице:</span>
                <select class="form-select form-select-sm w-auto shadow-none"
                        value="@Query.PageSize"
                        @onchange="HandlePageSizeChanged">
                    @foreach (var size in PageSizeOptions)
                    {
                        <option value="@size">@size</option>
                    }
                </select>
            </div>
        </div>

        <div class="d-flex align-items-center">
            <button
                class="btn btn-outline-secondary border-1 position-relative d-flex align-items-center justify-content-center p-2"
                title="Фильтры и сортировка"
                @onclick="OpenSettings">
                <i class="bi bi-funnel fs-5"></i>
                @if (Query.Filters.Any())
                {
                    <span
                        class="position-absolute top-0 start-100 translate-middle p-1 bg-primary border border-light rounded-circle">
                        <span class="visually-hidden">Активные фильтры</span>
                    </span>
                }
            </button>
        </div>
    </div>

    @if (Query.Filters.Any())
    {
        <div class="d-flex flex-wrap gap-2 mb-4 animate__animated animate__fadeIn">
            @foreach (var filter in Query.Filters)
            {
                <div class="individual-filter-badge d-flex align-items-center shadow-sm">
                    <span class="filter-label">@GetFilterDisplayName(filter.Key):</span>
                    <span class="filter-value mx-1">@GetFilterValueDisplay(filter)</span>
                    <button class="btn-remove-filter ms-1" @onclick="() => RemoveFilter(filter.Key)">
                        <i class="bi bi-x"></i>
                    </button>
                </div>
            }
            <button class="btn btn-link btn-sm text-decoration-none text-muted p-0 ms-2" @onclick="ClearAllFilters">
                Сбросить все
            </button>
        </div>
    }

    <div class="position-relative min-vh-50">
        @if (IsLoading)
        {
            <div class="loader-overlay rounded-4">
                <div class="spinner-border text-primary" role="status"></div>
            </div>
        }

        <div class="row g-4">
            @if (Data.Items != null && Data.Items.Any())
            {
                @foreach (var item in Data.Items)
                {
                    <div class="col-sm-12 col-md-6 col-lg-4 animate__animated animate__fadeIn">
                        @CardTemplate(item)
                    </div>
                }
            }
            else if (!IsLoading)
            {
                <div class="col-12 text-center py-5 border rounded-3 bg-light opacity-75">
                    <i class="bi bi-search text-muted display-4"></i>
                    <p class="mt-3 text-muted">Ничего не найдено по вашему запросу</p>
                </div>
            }
        </div>
    </div>
    
    <div class="d-flex justify-content-between align-items-center mt-3">
        <span class="text-muted small">
            Показано с @((Query.Page - 1) * Query.PageSize + 1) по @Math.Min(Query.Page * Query.PageSize, Data.TotalCount) из @Data.TotalCount
        </span>

        <nav>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Query.Page == 1 ? "disabled" : "")">
                    <button class="page-item page-link" @onclick="PrevPage"><i class="bi bi-chevron-left"></i></button>
                </li>
                
                @for (int i = 1; i <= TotalPages; i++)
                {
                    // Логика: показываем первую, последнюю и страницы вокруг текущей
                    // Если страниц мало (до 7), показываем все.
                    if (TotalPages <= 7 || (i >= Query.Page - 2 && i <= Query.Page + 2) || i == 1 || i == TotalPages)
                    {
                        var pageNumber = i;
                        <li class="page-item @(Query.Page == pageNumber ? "active" : "")">
                            <button class="page-link" @onclick="() => GoToPage(pageNumber)">@pageNumber</button>
                        </li>
                    }
                    else if (i == Query.Page - 3 || i == Query.Page + 3)
                    {
                        // Добавляем многоточие
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }
                }
                
                @*<li class="page-item active"><span class="page-link">@Query.Page</span></li>*@
                
                <li class="page-item @(Query.Page * Query.PageSize >= TotalPages ? "disabled" : "")">
                    <button class="page-item page-link" @onclick="NextPage"><i class="bi bi-chevron-right"></i></button>
                </li>
            </ul>
        </nav>
    </div>
</div>

<div class="modal fade @(_isModalVisible ? "show d-block" : "")" tabindex="-1"
     style="background: @(_isModalVisible ? "rgba(0,0,0,0.4)" : "none"); display: @(_isModalVisible ? "block" : "none")">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content shadow border-0">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Настройки вида</h5>
                <button type="button" class="btn-close shadow-none" @onclick="CloseSettings"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row">
                    <div class="col-md-5 border-end">
                        <label class="form-label small fw-bold text-muted text-uppercase mb-3">Сортировка</label>
                        <div class="d-grid gap-2">
                            @foreach (var sort in SortOptions)
                            {
                                <button
                                    class="btn btn-sm @(Query.SortBy == sort.Key ? "btn-primary" : "btn-outline-light text-dark border") d-flex justify-content-between align-items-center py-2 px-3 text-start shadow-none"
                                    @onclick="() => ApplySort(sort.Key)">
                                    @sort.Value
                                    @if (Query.SortBy == sort.Key)
                                    {
                                        <i class="bi @(Query.SortDesc ? "bi-sort-down" : "bi-sort-up")"></i>
                                    }
                                </button>
                            }
                        </div>
                    </div>
                    <div class="col-md-7 ps-md-4">
                        <label class="form-label small fw-bold text-muted text-uppercase mb-3">Фильтры</label>
                        <div class="d-flex flex-column gap-3">
                            @foreach (var template in FilterTemplates)
                            {
                                <div class="filter-item p-2 border rounded bg-light">
                                    @template
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-sm btn-link text-decoration-none text-muted" @onclick="ClearAllFilters">Сбросить
                    все
                </button>
                <button class="btn btn-primary px-4 shadow-none" @onclick="CloseSettings">Готово</button>
            </div>
        </div>
    </div>
</div>

<style>
    /* СТИЛИ ИНДИВИДУАЛЬНЫХ ЧИПСОВ */
    .individual-filter-badge {
        background: #f8f9fa;
        border: 1px solid #dee2e6;
        padding: 4px 12px;
        border-radius: 6px;
        font-size: 0.85rem;
        color: #495057;
        transition: all 0.2s;
    }

    .individual-filter-badge:hover {
        background: #e9ecef;
    }

    .filter-label {
        color: #6c757d;
        font-weight: 500;
    }

    .filter-value {
        color: #212529;
        font-weight: 700;
    }

    .btn-remove-filter {
        background: none;
        border: none;
        padding: 0;
        margin: 0;
        color: #adb5bd;
        display: flex;
        align-items: center;
        transition: color 0.2s;
    }

    .btn-remove-filter:hover {
        color: #dc3545;
    }

    /* ОВЕРЛЕЙ ЗАГРУЗКИ */
    .loader-overlay {
        position: absolute;
        inset: 0;
        background: rgba(255, 255, 255, 0.7);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10;
        backdrop-filter: blur(2px);
    }

    /* ПАГИНАЦИЯ */
    .pagination .page-link {
        color: #495057;
        border: 1px solid #dee2e6;
        padding: 0.4rem 0.8rem;
    }

    .pagination .page-item.active .page-link {
        background-color: #0d6efd;
        border-color: #0d6efd;
    }
</style>

@code {
    [Parameter, EditorRequired] public PagedResult<TItem> Data { get; set; } = default!;
    [Parameter][EditorRequired] public CardQuery Query { get; set; } = new();
    [Parameter][EditorRequired] public EventCallback<CardQuery> OnQueryChanged { get; set; }
    [Parameter] public RenderFragment<TItem> CardTemplate { get; set; } = default!;
    [Parameter] public List<RenderFragment> FilterTemplates { get; set; } = [];
    [Parameter] public Dictionary<string, string> SortOptions { get; set; } = [];
    [Parameter] public Dictionary<string, string> FilterDisplayNames { get; set; } = [];
    [Parameter] public string StorageKey { get; set; } = "";
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public List<int> PageSizeOptions { get; set; } = [3, 6, 9, 12, 15];

    private bool _isModalVisible;
    private string _searchText = "";
    private CancellationTokenSource? _searchCts;
    private CardsState _state = new();
    
    
    private int TotalPages => (int)Math.Ceiling((double)Data.TotalCount / Query.PageSize);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !string.IsNullOrEmpty(StorageKey))
        {
            var saved = await Storage.GetItemAsync<CardsState>($"{StorageKey}_settings");
            if (saved != null)
            {
                _state = saved;
                Query.PageSize = _state.PageSize;
                Query.Page = _state.CurrentPage;
                Query.SortBy = _state.SortBy;
                Query.SortDesc = _state.SortDesc;
                foreach (var f in _state.Filters) Query.Filters[f.Key] = f.Value;

                await OnQueryChanged.InvokeAsync(Query);
                StateHasChanged();
            }
        }
    }

    private async Task HandleSearchInput(ChangeEventArgs e)
    {
        _searchText = e.Value?.ToString() ?? "";
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();

        try
        {
            await Task.Delay(500, _searchCts.Token);
            Query.Search = _searchText;
            Query.Page = 1;
            await TriggerQueryUpdate();
        }
        catch (TaskCanceledException)
        {
        }
    }

    private async Task ClearSearch()
    {
        _searchText = "";
        Query.Search = "";
        await TriggerQueryUpdate();
    }

    private async Task TriggerQueryUpdate()
    {
        await OnQueryChanged.InvokeAsync(Query);
        await SaveState();
    }

    private async Task SaveState()
    {
        if (string.IsNullOrEmpty(StorageKey)) return;
        _state.PageSize = Query.PageSize;
        _state.CurrentPage = Query.Page;
        _state.SortBy = Query.SortBy;
        _state.SortDesc = Query.SortDesc;
        _state.Filters = Query.Filters.ToDictionary(k => k.Key, v => v.Value);
        await Storage.SetItemAsync($"{StorageKey}_settings", _state);
    }

    private void OpenSettings()
    {
        _isModalVisible = true;
    }

    private void CloseSettings()
    {
        _isModalVisible = false;
    }

    private async Task ApplySort(string key)
    {
        if (Query.SortBy == key) Query.SortDesc = !Query.SortDesc;
        else
        {
            Query.SortBy = key;
            Query.SortDesc = false;
        }

        await TriggerQueryUpdate();
    }

    private async Task GoToPage(int page)
    {
        Query.Page = page;
        await TriggerQueryUpdate();
    }

    private async Task PrevPage()
    {
        await GoToPage(Math.Max(1, Query.Page - 1));
    }

    private async Task NextPage()
    {
        await GoToPage(Math.Min(TotalPages, Query.Page + 1));
    }

    private async Task HandlePageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size))
        {
            Query.PageSize = size;
            Query.Page = 1;
            await TriggerQueryUpdate();
        }
    }

    private async Task RemoveFilter(string key)
    {
        Query.Filters.Remove(key);
        await TriggerQueryUpdate();
    }

    private async Task ClearAllFilters()
    {
        Query.Filters.Clear();
        await TriggerQueryUpdate();
    }

    private string GetFilterDisplayName(string key)
    {
        return FilterDisplayNames.GetValueOrDefault(key, key);
    }

    private string GetFilterValueDisplay(KeyValuePair<string, object?> filter)
    {
        if (filter.Value is IEnumerable enumerable && filter.Value is not string)
        {
            var list = enumerable.Cast<object>().Select(x => x.ToString()).ToList();
            if (!list.Any()) return "—";
            return list.Count > 2 ? $"{list[0]}, {list[1]} +{list.Count - 2}" : string.Join(", ", list);
        }

        return filter.Value?.ToString() ?? "—";
    }

}