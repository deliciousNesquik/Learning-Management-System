@if (IsVisible)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-primary text-white border-0 text-center">
                    <h5 class="modal-title w-100 fw-bold">
                        <i class="bi bi-key me-2"></i> @Title
                    </h5>
                </div>
                <div class="modal-body p-4 text-center">
                    @if (!IsSaved)
                    {
                        <p class="text-muted">@PromptText</p>
                     
                        @* --- БЛОК ОШИБКИ --- *@
                        @if (!string.IsNullOrEmpty(ErrorMessage))
                        {
                            <div class="alert alert-danger small py-2" role="alert">
                                <i class="bi bi-x-circle me-2"></i> @ErrorMessage
                            </div>
                        }
                        
                        <input type="text" 
                               value="@Password" 
                               @oninput="HandleInput"
                               class="form-control form-control-lg text-center fw-bold" 
                               placeholder="••••••••"/>
                        
                        <div class="d-flex justify-content-center mt-4 gap-2">
                            <button class="btn btn-light px-4" @onclick="Close">Отмена</button>
                            <button class="btn btn-primary px-4 fw-bold" 
                                    @onclick="HandleConfirm" 
                                    disabled="@(string.IsNullOrWhiteSpace(Password))">
                                Обновить
                            </button>
                        </div>
                    }
                    else
                    {
                        <i class="bi bi-check-circle text-success fs-1"></i>
                        <p class="mt-2 fw-bold">Пароль успешно обновлен!</p>
                        <div class="p-3 bg-light border rounded mb-3">
                            <code class="fs-5">@Password</code>
                        </div>
                        <button class="btn btn-primary w-100" @onclick="Close">Закрыть</button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public bool IsSaved { get; set; }
    [Parameter] public string Password { get; set; } = "";
    [Parameter] public string Title { get; set; } = "Сброс пароля";
    [Parameter] public string PromptText { get; set; } = "Введите новый пароль:";
    [Parameter] public string ErrorMessage { get; set; } = "";
    
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> PasswordChanged { get; set; }
    

    private async Task HandleInput(ChangeEventArgs e)
    {
        Password = e.Value?.ToString() ?? "";
        await PasswordChanged.InvokeAsync(Password);
    }

    private async Task HandleConfirm()
    {
        await PasswordChanged.InvokeAsync(Password);
        await OnConfirm.InvokeAsync();
    }
    
    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }
}