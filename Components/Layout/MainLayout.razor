@using LMS.Components.Shared
@using LMS.Models
@using LMS.Models.Database
@using LMS.Services
@using Microsoft.AspNetCore.Components.Authorization
@inherits LayoutComponentBase
@inject UserRequestContext UserRequestContext


<nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
    <div class="container-fluid">
        <img src="@Assets["icons/logo.png"]" width="50" height="50" alt="logo"/>
        <a class="navbar-brand" href="#">СДО</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
                aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                
                <AuthorizeView Roles="Admin">
                    <Authorized>
                        <li class="nav-item dropdown dropdown-center">
                            <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                Администрирование
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                                @if (_canReadAdministrators) { <li><a class="dropdown-item" href="/administrators">Администраторы</a></li> }
                                else if (!_canReadAdministrators) { <li><a class="dropdown-item disabled" href="/">Администраторы</a></li> }

                                @if (_canReadOrganizations) { <li><a class="dropdown-item" href="/organizations">Организации</a></li> }
                                else if (!_canReadOrganizations) { <li><a class="dropdown-item disabled" href="/">Организации</a></li> }

                                @if (_canReadBranches) { <li><a class="dropdown-item" href="/branches">Филиалы</a></li> }
                                else if (!_canReadBranches) { <li><a class="dropdown-item disabled" href="/">Филиалы</a></li> }

                                @if (_canReadDirectors) { <li><a class="dropdown-item" href="/directors">Директора</a></li> }
                                else if (!_canReadDirectors) { <li><a class="dropdown-item disabled" href="/">Директора</a></li> }

                                @if (_canReadSubscriptions) { <li><a class="dropdown-item" href="/subscriptions">Подписки</a></li> }
                                else if (!_canReadSubscriptions) { <li><a class="dropdown-item disabled" href="/">Подписки</a></li> }

                                @if (_canReadModerators) { <li><a class="dropdown-item" href="/moderators">Модераторы</a></li> }
                                else if (!_canReadModerators) { <li><a class="dropdown-item disabled" href="/">Модераторы</a></li> }

                                @if (_canReadAuditHistory)
                                {
                                    <li> <hr class="dropdown-divider"> </li>
                                    <li><a class="dropdown-item" href="/auditHistory">История изменения таблиц</a></li>
                                }
                                </ul>
                        </li>
                    </Authorized>
                </AuthorizeView>
                
                <AuthorizeView Roles="Admin, Moderator">
                    <Authorized>
                        <li class="nav-item dropdown dropdown-center">
                            <a class="nav-link dropdown-toggle" href="#" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                Управление уч. материалом
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                                
                                @if (_canReadCourses) { <li><a class="dropdown-item" href="/courses">Курсы</a></li> }
                                else if(!_canReadCourses) { <li><a class="dropdown-item disabled" href="#">Курсы</a></li> }
                                
                                @if (_canReadMaterials) { <li><a class="dropdown-item" href="/materials">Материалы</a></li> }
                                else if(!_canReadMaterials) { <li><a class="dropdown-item disabled" href="#">Материалы</a></li> }
                                
                                @if (_canReadAssessments) { <li><a class="dropdown-item" href="/assessments">Тесты</a></li> }
                                else if(!_canReadAssessments) { <li><a class="dropdown-item disabled" href="#">Тесты</a></li> }
                            </ul>
                        </li>
                    </Authorized>
                </AuthorizeView>
                
                <AuthorizeView Roles="Moderator">
                    <Authorized>
                        <li class="nav-item dropdown dropdown-center">
                            <a class="nav-link dropdown-toggle" href="#" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                Управление обучением
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                                @if (_canReadCoursesAssignments) { <li><a class="dropdown-item" href="/courses_assignments">Назначение обучения</a></li> }
                                else if(!_canReadCoursesAssignments) { <li><a class="dropdown-item disabled" href="#">Назначение обучения</a></li> }
                                
                                @if (_canReadCoursesEnrollments) { <li><a class="dropdown-item" href="/courses_enrollments">Статистика обучения</a></li> }
                                else if(!_canReadCoursesEnrollments) { <li><a class="dropdown-item disabled" href="#">Статистика обучения</a></li> }
                                
                                @if (_canReadAssessmentsAttempts) { <li><a class="dropdown-item" href="/assessments_attempts">Статистика тестирования</a></li> }
                                else if(!_canReadAssessmentsAttempts) { <li><a class="dropdown-item disabled" href="#">Статистика тестирования</a></li> }
                            </ul>
                        </li>
                    </Authorized>
                </AuthorizeView>
                
                <AuthorizeView Roles="Employee">
                    <Authorized>
                        <li class="nav-item dropdown dropdown-center">
                            <a class="nav-link dropdown-toggle" href="#" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                Обучение
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                                <li><a class="dropdown-item" href="#">Моё обучение</a></li>
                                
                                <li> <hr class="dropdown-divider"> </li>
                                
                                <li><a class="dropdown-item" href="#">Статистика обучения</a></li>
                                <li><a class="dropdown-item" href="#">Статистика тестирования</a></li>
                            </ul>
                        </li>
                    </Authorized>
                </AuthorizeView>
                

                <AuthorizeView Roles="Moderator">
                    <Authorized>
                        <li class="nav-item dropdown dropdown-center">
                            <a class="nav-link dropdown-toggle" href="#" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                Обучающиеся
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                                
                                @if (_canReadEmployees) { <li><a class="dropdown-item" href="/employees">Обучающиеся</a></li> }
                                else if(!_canReadEmployees) { <li><a class="dropdown-item disabled" href="#">Обучающиеся</a></li> }
                                
                                <li> <hr class="dropdown-divider"> </li>
                                
                                @if (_canReadEmployeesGroups) { <li><a class="dropdown-item" href="/employee_groups">Группы обучающихся</a></li> }
                                else if(!_canReadEmployeesGroups) { <li><a class="dropdown-item disabled" href="#">Группы обучающихся</a></li> }
                                
                                @if (_canReadGroupMembership) { <li><a class="dropdown-item" href="/group_membership">Назначение обучающихся в группы</a></li> }
                                else if(!_canReadGroupMembership) { <li><a class="dropdown-item disabled" href="#">Назначение обучающихся в группы</a></li> }
                                
                            </ul>
                        </li>
                    </Authorized>
                </AuthorizeView>
            </ul>
            <div class="d-flex align-items-center">
                <UserProfileModal/>
            </div>
        </div>
    </div>
</nav>

<main class="container-fluid p-0">
    @Body
</main>

@code {

    # region Есть ли право у пользователя на чтение
    private bool _canReadAdministrators;
    private bool _canReadOrganizations;
    private bool _canReadBranches;
    private bool _canReadDirectors;
    private bool _canReadSubscriptions;
    private bool _canReadModerators;
    private bool _canReadAuditHistory;
    
    private bool _canReadCourses;
    private bool _canReadMaterials;
    private bool _canReadAssessments;

    private bool _canReadCoursesAssignments;
    private bool _canReadCoursesEnrollments;
    private bool _canReadAssessmentsAttempts;
    
    private bool _canReadEmployees;
    private bool _canReadEmployeesGroups;
    private bool _canReadGroupMembership;
    # endregion

    protected override async Task OnInitializedAsync()
    {
        var userId = UserRequestContext.UserUuid;
        if (userId.HasValue)
        {
            _canReadAdministrators = await UserRequestContext.HasPermission(DbSchemaConstants.Administrators, SqlOperation.Select);
            _canReadOrganizations = await UserRequestContext.HasPermission(DbSchemaConstants.Organizations, SqlOperation.Select);
            _canReadBranches = await UserRequestContext.HasPermission(DbSchemaConstants.Branches, SqlOperation.Select);
            _canReadSubscriptions = await UserRequestContext.HasPermission(DbSchemaConstants.Subscriptions, SqlOperation.Select);
            _canReadDirectors = await UserRequestContext.HasPermission(DbSchemaConstants.Directors, SqlOperation.Select);
            _canReadModerators = await UserRequestContext.HasPermission(DbSchemaConstants.Moderators, SqlOperation.Select);
            _canReadAuditHistory = await UserRequestContext.HasPermission(DbSchemaConstants.AuditHistory, SqlOperation.Select);
            
            _canReadCourses = await UserRequestContext.HasPermission(DbSchemaConstants.Courses, SqlOperation.Select);
            _canReadMaterials = await UserRequestContext.HasPermission(DbSchemaConstants.Materials, SqlOperation.Select);
            _canReadAssessments = await UserRequestContext.HasPermission(DbSchemaConstants.Assessments, SqlOperation.Select);
            
            _canReadCoursesAssignments = await UserRequestContext.HasPermission(DbSchemaConstants.CoursesAssignments, SqlOperation.Select);
            _canReadCoursesEnrollments = await UserRequestContext.HasPermission(DbSchemaConstants.CoursesEnrollments, SqlOperation.Select);
            _canReadAssessmentsAttempts = await UserRequestContext.HasPermission(DbSchemaConstants.AssessmentsAttempts, SqlOperation.Select);
            
            _canReadEmployees = await UserRequestContext.HasPermission(DbSchemaConstants.Employees, SqlOperation.Select);
            _canReadEmployeesGroups = await UserRequestContext.HasPermission(DbSchemaConstants.EmployeesGroups, SqlOperation.Select);
            _canReadGroupMembership = await UserRequestContext.HasPermission(DbSchemaConstants.GroupMemberships, SqlOperation.Select);
        }
    }

}

<div id="blazor-error-ui" data-nosnippet>
    Произошла необработанная ошибка на стороне сервера.
    <a href="." class="reload">Перезагрузить</a>
    <span class="dismiss">🗙</span>
</div>