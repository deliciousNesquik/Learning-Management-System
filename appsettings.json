{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "ApplicationInsights": {
      "LogLevel": {
        "Default": "Warning"
      }
    }
  },
  
  "AllowedHosts": [ "localhost" ],
  
  "ConnectionStrings": {
    "PostgresConnection": "Server=147.45.97.215;Port=5432;Database=lms;"
  },

  "Security": {
    "Cors": {
      "AllowedOrigins": [ "http://localhost" ],
      "AllowCredentials": true
    },
    "Https": {
      "ForceHttps": true,
      "Hsts": {
        "Enabled": true,
        "MaxAge": 31536000,
        "IncludeSubDomains": true,
        "Preload": true
      }
    },
    "CookiePolicy": {
      "Secure": true,
      "SameSite": "Strict",
      "HttpOnly": true
    }
  },
  "RateLimiting": {
    "Enabled": true,
    "RequestsPerMinute": 60
  }
}
